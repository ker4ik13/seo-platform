# Copy to an untracked .env.worker on the remote machine.
# Caddy can serve a valid HTTPS certificate directly for an IP address.
WORKER_CONTROL_URL=https://144.31.221.28:4000
WORKER_NODE_ID=REPLACE_WITH_NODE_ID_FROM_ADMIN
WORKER_NODE_TOKEN=REPLACE_WITH_TOKEN_FROM_ADMIN
WORKER_HTTP_SLOTS=16
# One batch claim per server every 5 seconds; zero keeps paid work disabled.
WORKER_RANK_SLOTS=0
WORKER_CPU_SLOTS=2
WORKER_HEARTBEAT_MS=10000
WORKER_CONTAINER_CPUS=4.0
WORKER_CONTAINER_MEMORY=8g
