# Copy to an untracked .env.worker on the remote machine.
# Caddy can serve a valid HTTPS certificate directly for an IP address.
WORKER_CONTROL_URL=https://144.31.221.28:3000
WORKER_NODE_ID=REPLACE_WITH_NODE_ID_FROM_ADMIN
WORKER_NODE_TOKEN=REPLACE_WITH_TOKEN_FROM_ADMIN
WORKER_HTTP_SLOTS=16
# Один пакетный запрос: каждые 5 секунд в простое, после завершения пачки быстрее.
# RANK=0 отключает только позиции. Остальные возможности отключаются отдельно.
WORKER_RANK_SLOTS=0
WORKER_CPU_SLOTS=2
WORKER_WORDSTAT_SLOTS=10
WORKER_RESEARCH_SLOTS=10
WORKER_AI_ANSWER_SLOTS=5
WORKER_CLUSTERING_SLOTS=2
WORKER_CRAWL_SLOTS=8
WORKER_IMPORT_SLOTS=2
WORKER_EXPORT_SLOTS=2
WORKER_INSPECTION_SLOTS=1
WORKER_CPU_TASK_MEMORY_MB=1024
WORKER_HEARTBEAT_MS=10000
# Только на доверенном ПК: текст поисковых фраз в Docker logs (не API-ключи).
WORKER_LOG_QUERIES=false
WORKER_CONTAINER_CPUS=4.0
WORKER_CONTAINER_MEMORY=8g
WORKER_SCANNER_CPUS=1.0
WORKER_SCANNER_MEMORY=2g
