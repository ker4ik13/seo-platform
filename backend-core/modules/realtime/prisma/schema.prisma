generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CommentStatus {
  OPEN
  RESOLVED
  DELETED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WEB_PUSH
}

enum NotificationEventType {
  ASSIGNMENT
  MENTION
  SEMANTIC_IMPORT
  RANK_TRACKING
  FREQUENCY_COLLECTION
  SERP_COLLECTION
  CLUSTERING
  CRAWL_RADAR
  SITEMAP
  MAGNET
  AUTOMATION
  INTEGRATION
  JOB
  REPORT
  SECURITY
  BILLING
  PRODUCT
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationDeliveryMode {
  INSTANT
  HOURLY_DIGEST
  DAILY_DIGEST
}

enum ProjectNotificationMode {
  INHERIT
  OVERRIDE
  PAUSED
}

enum ProjectNotificationSubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum WebPushSubscriptionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum WebPushSubscriptionStatusReason {
  USER_REVOKED
  SESSION_REVOKED
  PERMISSION_REVOKED
  PUSH_SERVICE_GONE
  ACCOUNT_CHANGED
}

enum WebPushDeliveryStatus {
  NEVER
  DELIVERED
  FAILED
}

enum WebPushDeliveryAttemptStatus {
  PENDING
  CLAIMED
  RETRY_SCHEDULED
  DELIVERED
  FAILED_FINAL
  CANCELLED
}

model WebPushEncryptionKeyCanary {
  keyVersion Int      @id @map("key_version")
  ciphertext Bytes
  nonce      Bytes
  authTag    Bytes    @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("web_push_encryption_key_canaries")
}

model WebPushFingerprintKeyCanary {
  keyVersion Int      @id @map("key_version")
  digest     Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("web_push_fingerprint_key_canaries")
}

model CollaborationDocument {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  resourceType      String   @map("resource_type") @db.VarChar(64)
  resourceId        String   @map("resource_id") @db.Uuid
  stateVector       Bytes?   @map("state_vector")
  snapshotObjectKey String?  @map("snapshot_object_key") @db.Text
  version           BigInt   @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, resourceType, resourceId])
  @@index([workspaceId, projectId, active])
  @@map("collaboration_documents")
}

model Comment {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  targetType  String        @map("target_type") @db.VarChar(64)
  targetId    String        @map("target_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  body        String        @db.Text
  anchor      Json?
  status      CommentStatus @default(OPEN)
  resolvedBy  String?       @map("resolved_by") @db.Uuid
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, projectId, targetType, targetId, status])
  @@index([parentId])
  @@map("comments")
}

model Notification {
  id           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId  String               @map("workspace_id") @db.Uuid
  projectId    String?              @map("project_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  eventType    String               @map("type") @db.VarChar(100)
  severity     NotificationSeverity @default(INFO)
  title        String               @db.VarChar(255)
  body         String?              @db.Text
  actorId      String?              @map("actor_id") @db.Uuid
  resourceType String?              @map("resource_type") @db.VarChar(64)
  resourceId   String?              @map("resource_id") @db.Uuid
  deepLink     String?              @map("deep_link") @db.VarChar(600)
  data         Json?
  dedupeKey    String?              @map("dedupe_key") @db.VarChar(180)
  inAppVisible Boolean              @default(true) @map("in_app_visible")
  readAt       DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  webPushDeliveryAttempts WebPushDeliveryAttempt[]

  @@unique([userId, dedupeKey])
  @@unique([id, userId], map: "notifications_id_user_key")
  @@index([workspaceId, userId, readAt, createdAt])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_user_created_id_idx")
  @@index([userId, readAt, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_user_read_created_id_idx")
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @unique(map: "notification_preferences_user_id_key") @map("user_id") @db.Uuid
  inAppEnabled   Boolean  @default(true) @map("in_app_enabled")
  emailEnabled   Boolean  @default(false) @map("email_enabled")
  webPushEnabled Boolean  @default(false) @map("web_push_enabled")
  timezone       String   @default("UTC") @db.VarChar(64)
  quietStart     String?  @map("quiet_start") @db.VarChar(5)
  quietEnd       String?  @map("quiet_end") @db.VarChar(5)
  criticalBypass Boolean  @default(true) @map("critical_bypass")
  digestTime     String   @default("09:00") @map("digest_time") @db.VarChar(5)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rules         NotificationRule[]
  subscriptions ProjectNotificationSubscription[]

  @@map("notification_preferences")
}

model NotificationRule {
  id              String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  preferenceId    String                   @map("preference_id") @db.Uuid
  subscriptionId  String?                  @map("subscription_id") @db.Uuid
  scopeKey        String                   @map("scope_key") @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  projectId       String?                  @map("project_id") @db.Uuid
  eventType       NotificationEventType    @map("event_type")
  channel         NotificationChannel
  enabled         Boolean                  @default(true)
  minimumSeverity NotificationSeverity     @default(INFO) @map("minimum_severity")
  deliveryMode    NotificationDeliveryMode @default(INSTANT) @map("delivery_mode")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  preference   NotificationPreference           @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  subscription ProjectNotificationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, eventType, channel], map: "notification_rules_scope_event_channel_key")
  @@index([userId, projectId, eventType, channel], map: "notification_rules_user_project_event_channel_idx")
  @@index([preferenceId, subscriptionId], map: "notification_rules_preference_subscription_idx")
  @@map("notification_rules")
}

model ProjectNotificationSubscription {
  id                String                                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  preferenceId      String                                @map("preference_id") @db.Uuid
  userId            String                                @map("user_id") @db.Uuid
  workspaceId       String                                @map("workspace_id") @db.Uuid
  projectId         String                                @map("project_id") @db.Uuid
  membershipId      String                                @map("membership_id") @db.Uuid
  membershipVersion Int                                   @map("membership_version")
  mode              ProjectNotificationMode               @default(INHERIT)
  pausedUntil       DateTime?                             @map("paused_until") @db.Timestamptz(6)
  notifyOwnJobs     Boolean                               @default(true) @map("notify_own_jobs")
  status            ProjectNotificationSubscriptionStatus @default(ACTIVE)
  version           Int                                   @default(1)
  createdAt         DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt     DateTime?                             @map("deactivated_at") @db.Timestamptz(6)

  preference NotificationPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  rules      NotificationRule[]

  @@unique([userId, projectId, membershipId, membershipVersion], map: "project_notification_subscription_membership_snapshot_key")
  @@index([workspaceId, projectId, status, userId], map: "project_notification_scope_status_user_idx")
  @@index([membershipId, status], map: "project_notification_subscriptions_membership_status_idx")
  @@map("project_notification_subscriptions")
}

model WebPushSubscription {
  id                          String                           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                      String                           @map("user_id") @db.Uuid
  installationId              String                           @map("installation_id") @db.Uuid
  registeredSessionFamilyId   String                           @map("registered_session_family_id") @db.Uuid
  status                      WebPushSubscriptionStatus        @default(ACTIVE)
  statusReason                WebPushSubscriptionStatusReason? @map("status_reason")
  endpointFingerprint         Bytes?                           @map("endpoint_fingerprint")
  materialFingerprint         Bytes?                           @map("material_fingerprint")
  materialCiphertext          Bytes?                           @map("material_ciphertext")
  materialNonce               Bytes?                           @map("material_nonce")
  materialAuthTag             Bytes?                           @map("material_auth_tag")
  encryptionKeyVersion        Int?                             @map("encryption_key_version")
  fingerprintKeyVersion       Int?                             @map("fingerprint_key_version")
  applicationServerKeyVersion Int                              @map("application_server_key_version")
  label                       String                           @db.VarChar(80)
  browser                     String                           @db.VarChar(32)
  platform                    String                           @db.VarChar(32)
  providerExpiresAt           DateTime?                        @map("provider_expires_at") @db.Timestamptz(6)
  lastSeenAt                  DateTime                         @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  lastDeliveryStatus          WebPushDeliveryStatus            @default(NEVER) @map("last_delivery_status")
  lastDeliveryAt              DateTime?                        @map("last_delivery_at") @db.Timestamptz(6)
  lastDeliveryErrorCode       String?                          @map("last_delivery_error_code") @db.VarChar(64)
  revokedAt                   DateTime?                        @map("revoked_at") @db.Timestamptz(6)
  expiredAt                   DateTime?                        @map("expired_at") @db.Timestamptz(6)
  version                     Int                              @default(1)
  createdAt                   DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveryAttempts WebPushDeliveryAttempt[]

  @@unique([userId, installationId], map: "web_push_subscriptions_user_installation_key")
  @@unique([id, userId], map: "web_push_subscriptions_id_user_key")
  @@index([userId, status, updatedAt(sort: Desc), id(sort: Desc)], map: "web_push_subscriptions_user_status_updated_idx")
  @@index([userId, registeredSessionFamilyId, status], map: "web_push_subscriptions_user_family_status_idx")
  @@index([status, providerExpiresAt], map: "web_push_subscriptions_status_expiry_idx")
  @@map("web_push_subscriptions")
}

model WebPushDeliveryAttempt {
  id                  String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId      String                       @map("notification_id") @db.Uuid
  subscriptionId      String                       @map("subscription_id") @db.Uuid
  userId              String                       @map("user_id") @db.Uuid
  subscriptionVersion Int                          @map("subscription_version")
  status              WebPushDeliveryAttemptStatus @default(PENDING)
  deliveryMode        NotificationDeliveryMode     @map("delivery_mode")
  policySnapshot      Json                         @map("policy_snapshot")
  payloadSnapshot     Json                         @map("payload_snapshot")
  attemptCount        Int                          @default(0) @map("attempt_count")
  maxAttempts         Int                          @default(8) @map("max_attempts")
  availableAt         DateTime                     @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseToken          String?                      @map("lease_token") @db.Uuid
  leaseExpiresAt      DateTime?                    @map("lease_expires_at") @db.Timestamptz(6)
  lastHttpStatus      Int?                         @map("last_http_status")
  lastErrorCode       String?                      @map("last_error_code") @db.VarChar(64)
  providerMessageId   String?                      @map("provider_message_id") @db.VarChar(255)
  deliveredAt         DateTime?                    @map("delivered_at") @db.Timestamptz(6)
  terminalAt          DateTime?                    @map("terminal_at") @db.Timestamptz(6)
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification Notification        @relation(fields: [notificationId, userId], references: [id, userId], onDelete: Restrict)
  subscription WebPushSubscription @relation(fields: [subscriptionId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([notificationId, subscriptionId], map: "web_push_delivery_notification_subscription_key")
  @@index([status, availableAt, leaseExpiresAt, id], map: "web_push_delivery_claim_idx")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "web_push_delivery_user_history_idx")
  @@index([subscriptionId, status, createdAt(sort: Desc)], map: "web_push_delivery_subscription_status_idx")
  @@map("web_push_delivery_attempts")
}

model RevokedSessionFamilyTombstone {
  userId          String   @map("user_id") @db.Uuid
  sessionFamilyId String   @map("session_family_id") @db.Uuid
  sourceEventId   String   @unique(map: "revoked_session_family_tombstones_source_event_key") @map("source_event_id") @db.Uuid
  revokedAt       DateTime @map("revoked_at") @db.Timestamptz(6)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([userId, sessionFamilyId], map: "revoked_session_family_tombstones_pkey")
  @@index([receivedAt, userId, sessionFamilyId], map: "revoked_session_family_tombstones_retention_idx")
  @@map("revoked_session_family_tombstones")
}

model RealtimeProjectTicket {
  id                     String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketHash             Bytes     @unique(map: "realtime_project_tickets_ticket_hash_key") @map("ticket_hash")
  originHash             Bytes     @map("origin_hash")
  userId                 String    @map("user_id") @db.Uuid
  sessionId              String    @map("session_id") @db.Uuid
  sessionFamilyId        String    @map("session_family_id") @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  projectId              String    @map("project_id") @db.Uuid
  membershipId           String    @map("membership_id") @db.Uuid
  membershipVersion      Int       @map("membership_version")
  clientInstanceId       String    @map("client_instance_id") @db.Uuid
  sessionExpiresAt       DateTime  @map("session_expires_at") @db.Timestamptz(6)
  issuedAt               DateTime  @map("issued_at") @db.Timestamptz(6)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  authorizationExpiresAt DateTime  @map("authorization_expires_at") @db.Timestamptz(6)
  invalidatedAt          DateTime? @map("invalidated_at") @db.Timestamptz(6)
  consumedAt             DateTime? @map("consumed_at") @db.Timestamptz(6)
  connectionId           String?   @map("connection_id") @db.VarChar(64)
  disconnectedAt         DateTime? @map("disconnected_at") @db.Timestamptz(6)

  @@index([userId, issuedAt(sort: Desc)], map: "realtime_project_tickets_user_issued_idx")
  @@index([userId, sessionFamilyId, authorizationExpiresAt], map: "realtime_project_tickets_family_lease_idx")
  @@index([authorizationExpiresAt, id], map: "realtime_project_tickets_retention_idx")
  @@map("realtime_project_tickets")
}

model InboxEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(160)
  consumer    String   @db.VarChar(100)
  scopeKey    String?  @map("scope_key") @db.VarChar(180)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@index([consumer, processedAt])
  @@map("inbox_events")
}

model OutboxEvent {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(160)
  aggregateId String       @map("aggregate_id") @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  payload     Json
  metadata    Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}
