generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum DataSourceMode {
  BYOK
  PLATFORM
  IMPORT
  MANUAL
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum SemanticImportReceiptStatus {
  RECEIVING
  COMPLETED
  ABORTED
}

enum TrackingContextStatus {
  ACTIVE
  ARCHIVED
}

enum TrackingSearchEngine {
  GOOGLE
  YANDEX
}

enum TrackingDevice {
  DESKTOP
  MOBILE
}

enum TrackingDomainMatchMode {
  EXACT_HOST
  INCLUDE_WWW
  INCLUDE_SUBDOMAINS
  CANONICAL_DOMAIN
  ANY_PROJECT_MIRROR
  SPECIFIC_URL
  URL_PREFIX
}

enum RankExecutionManifestStatus {
  BUILDING
  SEALED
  CLOSED
}

enum RankCheckFinalStatus {
  COMPLETED
  PARTIALLY_COMPLETED
  CANCELLED
  FAILED
  ACTION_REQUIRED
}

enum SemanticSavedViewScope {
  PRIVATE
  PROJECT_SHARED
}

enum KeywordGroupSystemKind {
  UNGROUPED
  TRASH
}

enum ClusteringProposalStatus {
  READY
  APPLIED
  REJECTED
}

enum SemanticCustomColumnType {
  TEXT
  LONG_TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTI_SELECT
  URL
  USER
  STATUS
}

enum PageType {
  EXISTING
  PLANNED
  REDIRECTED
  DELETED
  EXTERNAL
  UNKNOWN
}

enum PageIndexability {
  UNKNOWN
  INDEXABLE
  NOINDEX
  BLOCKED_ROBOTS
  CANONICALIZED
  REDIRECTED
  ERROR
}

enum PageSourceType {
  CRAWL
  SITEMAP
  SEARCH_CONSOLE
  WEBMASTER
  ANALYTICS
  MANUAL
  IMPORT
  CMS
}

enum CrawlIssueSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum CrawlDuplicateKind {
  CONTENT
  TITLE
  DESCRIPTION
  H1
}

enum CrawlMembershipStatus {
  COMPLETED
  PARTIALLY_COMPLETED
  CANCELLED
}

model Keyword {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  textOriginal   String         @map("text_original") @db.Text
  textNormalized String         @map("text_normalized") @db.Text
  normalizedHash String         @map("normalized_hash") @db.Char(64)
  language       String         @default("und") @db.VarChar(16)
  priority       Int            @default(0)
  isFavorite     Boolean        @default(false) @map("is_favorite")
  showAiAnswerButton Boolean     @default(false) @map("show_ai_answer_button")
  intent         String?        @db.VarChar(32)
  note           String?        @db.Text
  status         EntityStatus   @default(ACTIVE)
  clusterId      String?        @map("cluster_id") @db.Uuid
  targetPageId   String?        @map("target_page_id") @db.Uuid
  /// Per-keyword switch for scheduled/manual position tracking.
  isTracked      Boolean        @default(true) @map("is_tracked")
  customValues   Json           @default("{}") @map("custom_values")
  sourceMode     DataSourceMode @default(MANUAL) @map("source_mode")
  sourceId       String?        @map("source_id") @db.Uuid
  createdBy      String?        @map("created_by") @db.Uuid
  updatedBy      String?        @map("updated_by") @db.Uuid
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)

  memberships         KeywordGroupMembership[]
  tags                KeywordTag[]
  trackingAssignments TrackingContextKeywordAssignment[]
  rankManifestEntries RankExecutionManifestEntry[]
  rankSnapshots       RankSnapshot[]                     @relation("RankSnapshotKeyword")
  aiAnswerSnapshots   AiAnswerSnapshot[]                 @relation("AiAnswerSnapshotKeyword")
  typedCustomValues   SemanticKeywordCustomValue[]
  mergedInto          KeywordMerge?                       @relation("KeywordMergeSource")
  mergedSources       KeywordMerge[]                      @relation("KeywordMergeTarget")
  cluster             Cluster?                           @relation(fields: [workspaceId, projectId, clusterId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  targetPage          Page?                              @relation(fields: [workspaceId, projectId, targetPageId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, language, normalizedHash])
  @@unique([workspaceId, projectId, id], map: "keywords_tenant_project_id_key")
  @@index([workspaceId, projectId, status, id])
  @@index([workspaceId, projectId, status, createdAt(sort: Desc), id(sort: Desc)], map: "keywords_workspace_project_status_created_id_idx")
  @@index([workspaceId, projectId, status, updatedAt(sort: Desc), id(sort: Desc)], map: "keywords_workspace_project_status_updated_id_idx")
  @@index([workspaceId, projectId, status, textNormalized, id], map: "keywords_workspace_project_status_text_id_idx")
  @@index([workspaceId, projectId, status, priority(sort: Desc), id(sort: Desc)], map: "keywords_workspace_project_status_priority_id_idx")
  @@index([workspaceId, projectId, status, sourceMode, id], map: "keywords_workspace_project_status_source_id_idx")
  @@index([workspaceId, projectId, status, intent, createdAt(sort: Desc), id(sort: Desc)], map: "keywords_workspace_project_status_intent_created_idx")
  @@index([textNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "keywords_text_normalized_trgm_idx")
  @@index([projectId, clusterId, id])
  @@index([projectId, targetPageId, id])
  @@index([projectId, isTracked, id])
  @@map("keywords")
}

model KeywordMerge {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  sourceKeywordId String   @map("source_keyword_id") @db.Uuid
  targetKeywordId String   @map("target_keyword_id") @db.Uuid
  sourceText      String   @map("source_text") @db.Text
  sourceLanguage  String   @map("source_language") @db.VarChar(16)
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  source Keyword @relation("KeywordMergeSource", fields: [workspaceId, projectId, sourceKeywordId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  target Keyword @relation("KeywordMergeTarget", fields: [workspaceId, projectId, targetKeywordId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, projectId, sourceKeywordId], map: "keyword_merges_source_key")
  @@index([workspaceId, projectId, targetKeywordId], map: "keyword_merges_target_idx")
  @@map("keyword_merges")
}

model SemanticCustomColumn {
  id             String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String                   @map("workspace_id") @db.Uuid
  projectId      String                   @map("project_id") @db.Uuid
  name           String                   @db.VarChar(160)
  normalizedName String                   @map("normalized_name") @db.VarChar(160)
  description    String?                  @db.Text
  type           SemanticCustomColumnType
  config         Json
  status         EntityStatus             @default(ACTIVE)
  version        Int                      @default(1)
  createdBy      String                   @map("created_by") @db.Uuid
  updatedBy      String                   @map("updated_by") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?                @map("deleted_at") @db.Timestamptz(6)

  values SemanticKeywordCustomValue[]

  @@unique([workspaceId, projectId, id], map: "semantic_custom_columns_tenant_project_id_key")
  @@index([workspaceId, projectId, status, name, id], map: "semantic_custom_columns_project_status_name_idx")
  @@map("semantic_custom_columns")
}

model SemanticKeywordCustomValue {
  workspaceId      String    @map("workspace_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  keywordId        String    @map("keyword_id") @db.Uuid
  columnId         String    @map("column_id") @db.Uuid
  textValue        String?   @map("text_value") @db.Text
  integerValue     BigInt?   @map("integer_value")
  decimalValue     Decimal?  @map("decimal_value") @db.Decimal(30, 10)
  booleanValue     Boolean?  @map("boolean_value")
  dateValue        DateTime? @map("date_value") @db.Date
  datetimeValue    DateTime? @map("datetime_value") @db.Timestamptz(6)
  stringArrayValue String[]  @default([]) @map("string_array_value")
  userId           String?   @map("user_id") @db.Uuid
  version          Int       @default(1)
  updatedBy        String    @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  keyword Keyword              @relation(fields: [workspaceId, projectId, keywordId], references: [workspaceId, projectId, id], onDelete: Cascade)
  column  SemanticCustomColumn @relation(fields: [workspaceId, projectId, columnId], references: [workspaceId, projectId, id], onDelete: Restrict)

  @@id([keywordId, columnId])
  @@index([workspaceId, projectId, columnId, textValue], map: "semantic_keyword_custom_values_text_idx")
  @@index([workspaceId, projectId, columnId, integerValue], map: "semantic_keyword_custom_values_integer_idx")
  @@index([workspaceId, projectId, columnId, decimalValue], map: "semantic_keyword_custom_values_decimal_idx")
  @@index([workspaceId, projectId, columnId, booleanValue], map: "semantic_keyword_custom_values_boolean_idx")
  @@index([workspaceId, projectId, columnId, dateValue], map: "semantic_keyword_custom_values_date_idx")
  @@index([workspaceId, projectId, columnId, datetimeValue], map: "semantic_keyword_custom_values_datetime_idx")
  @@index([workspaceId, projectId, columnId, userId], map: "semantic_keyword_custom_values_user_idx")
  @@map("semantic_keyword_custom_values")
}

model SemanticSavedView {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String                 @map("workspace_id") @db.Uuid
  projectId      String                 @map("project_id") @db.Uuid
  ownerId        String                 @map("owner_id") @db.Uuid
  scope          SemanticSavedViewScope
  name           String                 @db.VarChar(160)
  normalizedName String                 @map("normalized_name") @db.VarChar(160)
  config         Json
  status         EntityStatus           @default(ACTIVE)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?              @map("deleted_at") @db.Timestamptz(6)

  @@unique([workspaceId, projectId, id], map: "semantic_saved_views_tenant_project_id_key")
  @@index([workspaceId, projectId, scope, status, updatedAt(sort: Desc), id(sort: Desc)], map: "semantic_saved_views_project_scope_status_updated_idx")
  @@index([workspaceId, projectId, ownerId, status, updatedAt(sort: Desc), id(sort: Desc)], map: "semantic_saved_views_owner_status_updated_idx")
  @@map("semantic_saved_views")
}

model SemanticNegativeKeywordPreset {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String       @map("workspace_id") @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  name              String       @db.VarChar(160)
  normalizedName    String       @map("normalized_name") @db.VarChar(160)
  words             String[]
  matchMode         String       @map("match_mode") @db.VarChar(32)
  caseSensitive     Boolean      @default(false) @map("case_sensitive")
  ignoreWordOrder   Boolean      @default(false) @map("ignore_word_order")
  ignorePunctuation Boolean      @default(false) @map("ignore_punctuation")
  status            EntityStatus @default(ACTIVE)
  version           Int          @default(1)
  createdBy         String       @map("created_by") @db.Uuid
  updatedBy         String       @map("updated_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@unique([workspaceId, projectId, id], map: "semantic_negative_keyword_presets_tenant_project_id_key")
  @@index([workspaceId, projectId, status, normalizedName, id], map: "semantic_negative_keyword_presets_project_name_idx")
  @@map("semantic_negative_keyword_presets")
}

model KeywordGroup {
  id          String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  parentId    String?                 @map("parent_id") @db.Uuid
  name        String                  @db.VarChar(255)
  path        String?                 @db.Text
  pathHash    String?                 @map("path_hash") @db.Char(64)
  color       String?                 @db.VarChar(16)
  position    Int                     @default(0)
  systemKind  KeywordGroupSystemKind? @map("system_kind")
  status      EntityStatus            @default(ACTIVE)
  version     Int                     @default(1)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships KeywordGroupMembership[]

  @@unique([projectId, pathHash])
  @@index([projectId, parentId, position])
  @@map("keyword_groups")
}

model SemanticGroupColorLegend {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  entries         Json     @default("[]")
  version         Int      @default(1)
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reads SemanticGroupColorLegendRead[]

  @@unique([workspaceId, projectId], map: "semantic_group_color_legends_tenant_project_key")
  @@map("semantic_group_color_legends")
}

model SemanticGroupColorLegendRead {
  legendId    String   @map("legend_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  seenVersion Int      @map("seen_version")
  seenAt      DateTime @updatedAt @map("seen_at") @db.Timestamptz(6)

  legend SemanticGroupColorLegend @relation(fields: [legendId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([legendId, userId])
  @@index([userId, seenAt(sort: Desc)], map: "semantic_group_color_legend_reads_user_seen_idx")
  @@map("semantic_group_color_legend_reads")
}

model KeywordGroupMembership {
  projectId String   @map("project_id") @db.Uuid
  keywordId String   @map("keyword_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  keyword Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  group   KeywordGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([keywordId, groupId])
  @@index([projectId, groupId, keywordId])
  @@map("keyword_group_memberships")
}

model Tag {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  name           String       @db.VarChar(160)
  normalizedName String       @map("normalized_name") @db.VarChar(160)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  keywords KeywordTag[]

  @@unique([projectId, normalizedName])
  @@index([workspaceId, projectId, status, name])
  @@map("tags")
}

model KeywordTag {
  projectId String   @map("project_id") @db.Uuid
  keywordId String   @map("keyword_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([keywordId, tagId])
  @@index([projectId, tagId, keywordId])
  @@map("keyword_tags")
}

model Cluster {
  id                      String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId             String       @map("workspace_id") @db.Uuid
  projectId               String       @map("project_id") @db.Uuid
  name                    String       @db.VarChar(255)
  method                  String       @db.VarChar(64)
  evidence                Json?
  primaryPageId           String?      @map("primary_page_id") @db.Uuid
  pageMappingSource       String?      @map("page_mapping_source") @db.VarChar(16)
  pageMappingConfidence   Float?       @map("page_mapping_confidence")
  pageMappingRationale    String?      @map("page_mapping_rationale") @db.Text
  isLocked                Boolean      @default(false) @map("is_locked")
  excludeFromReclustering Boolean      @default(false) @map("exclude_from_reclustering")
  status                  EntityStatus @default(ACTIVE)
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  keywords                Keyword[]
  primaryPage             Page?        @relation("ClusterPrimaryPage", fields: [workspaceId, projectId, primaryPageId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, projectId, id], map: "clusters_tenant_project_id_key")
  @@index([projectId, status, id])
  @@index([workspaceId, projectId, primaryPageId, status, id], map: "clusters_primary_page_idx")
  @@index([workspaceId, projectId, status, isLocked, excludeFromReclustering, id], map: "clusters_reclustering_eligibility_idx")
  @@map("clusters")
}

model ClusteringProposal {
  id                    String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId           String                   @map("workspace_id") @db.Uuid
  projectId             String                   @map("project_id") @db.Uuid
  jobId                 String                   @unique(map: "clustering_proposals_job_id_key") @map("job_id") @db.Uuid
  provider              String                   @db.VarChar(32)
  connectorVersion      String                   @map("connector_version") @db.VarChar(100)
  parameters            Json
  status                ClusteringProposalStatus @default(READY)
  keywordCount          Int                      @map("keyword_count")
  clusterCount          Int                      @map("cluster_count")
  unclusteredCount      Int                      @map("unclustered_count")
  appliedKeywordCount   Int                      @default(0) @map("applied_keyword_count")
  createdGroupCount     Int                      @default(0) @map("created_group_count")
  semanticVersionIds    Json                     @default("[]") @map("semantic_version_ids")
  version               Int                      @default(1)
  createdBy             String                   @map("created_by") @db.Uuid
  appliedBy             String?                  @map("applied_by") @db.Uuid
  rejectedBy            String?                  @map("rejected_by") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  appliedAt             DateTime?                @map("applied_at") @db.Timestamptz(6)
  rejectedAt            DateTime?                @map("rejected_at") @db.Timestamptz(6)

  clusters ClusteringProposalCluster[]
  items    ClusteringProposalItem[]

  @@unique([workspaceId, projectId, id], map: "clustering_proposals_tenant_project_id_key")
  @@index([workspaceId, projectId, status, createdAt(sort: Desc), id(sort: Desc)], map: "clustering_proposals_project_status_created_idx")
  @@map("clustering_proposals")
}

model ClusteringProposalCluster {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  proposalId       String   @map("proposal_id") @db.Uuid
  sequence         Int
  providerKey      String   @map("provider_key") @db.VarChar(255)
  name             String   @db.VarChar(255)
  topUrl           String?  @map("top_url") @db.Text
  topUrls          Json     @default("[]") @map("top_urls")
  frequencySum     BigInt?  @map("frequency_sum")
  mainPageCount    Int?     @map("main_page_count")
  keywordCount     Int      @map("keyword_count")
  appliedClusterId String?  @map("applied_cluster_id") @db.Uuid
  appliedGroupId   String?  @map("applied_group_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  proposal ClusteringProposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  items    ClusteringProposalItem[]

  @@unique([proposalId, sequence], map: "clustering_proposal_clusters_sequence_key")
  @@unique([proposalId, providerKey], map: "clustering_proposal_clusters_provider_key")
  @@index([proposalId, id], map: "clustering_proposal_clusters_proposal_idx")
  @@map("clustering_proposal_clusters")
}

model ClusteringProposalItem {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  proposalId          String   @map("proposal_id") @db.Uuid
  proposalClusterId   String?  @map("proposal_cluster_id") @db.Uuid
  sequence            Int
  keywordId           String   @map("keyword_id") @db.Uuid
  keywordVersion      Int      @map("keyword_version")
  keywordText         String   @map("keyword_text") @db.Text
  frequency           BigInt?
  exactFrequency      BigInt?  @map("exact_frequency")
  aggregatorsPercent  Float?   @map("aggregators_percent")
  toponym             String?  @db.VarChar(255)
  geoDependent        Boolean? @map("geo_dependent")
  appliedClusterId    String?  @map("applied_cluster_id") @db.Uuid
  appliedGroupId      String?  @map("applied_group_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  proposal        ClusteringProposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  proposalCluster ClusteringProposalCluster? @relation(fields: [proposalClusterId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([proposalId, sequence], map: "clustering_proposal_items_sequence_key")
  @@unique([proposalId, keywordId], map: "clustering_proposal_items_keyword_key")
  @@index([proposalId, proposalClusterId, sequence], map: "clustering_proposal_items_cluster_sequence_idx")
  @@map("clustering_proposal_items")
}

model Page {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  url              String           @db.Text
  normalizedUrl    String           @map("normalized_url") @db.Text
  urlHash          String           @map("url_hash") @db.Char(64)
  pageType         PageType         @default(UNKNOWN) @map("page_type")
  indexability     PageIndexability @default(UNKNOWN)
  httpStatus       Int?             @map("http_status")
  canonicalTarget  String?          @map("canonical_target") @db.Text
  robots           String?          @db.VarChar(255)
  title            String?          @db.Text
  description      String?          @db.Text
  h1               String?          @db.Text
  language         String?          @db.VarChar(16)
  template         String?          @db.VarChar(160)
  contentStatus    String?          @map("content_status") @db.VarChar(64)
  ownerId          String?          @map("owner_id") @db.Uuid
  priority         Int              @default(0)
