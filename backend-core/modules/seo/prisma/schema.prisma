  provider       String         @db.VarChar(32)
  sourceMode     DataSourceMode @map("source_mode")
  jobId          String         @map("job_id") @db.Uuid
  observedAt     DateTime       @map("observed_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  keyword Keyword          @relation("AiAnswerSnapshotKeyword", fields: [workspaceId, projectId, keywordId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_answer_snapshots_keyword_tenant_fkey")
  sources AiAnswerSource[]

  @@unique([jobId, keywordId, searchEngine], map: "ai_answer_snapshots_job_keyword_engine_key")
  @@index([workspaceId, projectId, keywordId, searchEngine, observedAt(sort: Desc), id(sort: Desc)], map: "ai_answer_snapshots_keyword_engine_latest_idx")
  @@index([workspaceId, projectId, jobId], map: "ai_answer_snapshots_job_idx")
  @@map("ai_answer_snapshots")
}

model AiAnswerSource {
  snapshotId  String   @map("snapshot_id") @db.Uuid
  position    Int
  providerId  Int?     @map("provider_id")
  url         String   @db.Text
  title       String?  @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  snapshot AiAnswerSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ai_answer_sources_snapshot_fkey")

  @@id([snapshotId, position])
  @@map("ai_answer_sources")
}

model SemanticVersion {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  number          Int
  reason          String    @db.VarChar(160)
  actorId         String    @map("actor_id") @db.Uuid
  sourceJobId     String?   @map("source_job_id") @db.Uuid
  parentVersionId String?   @map("parent_version_id") @db.Uuid
  summary         String    @default("") @db.VarChar(500)
  affectedCount   Int       @default(0) @map("affected_count")
  reversible      Boolean   @default(false)
  manifest        Json
  finalizedAt     DateTime? @map("finalized_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  parent              SemanticVersion?       @relation("SemanticVersionParent", fields: [workspaceId, projectId, parentVersionId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  children            SemanticVersion[]      @relation("SemanticVersionParent")
  changes             SemanticEntityChange[]
  undoSourceReceipts  SemanticUndoReceipt[]  @relation("SemanticUndoSourceVersion")
  undoCreatedReceipts SemanticUndoReceipt[]  @relation("SemanticUndoCreatedVersion")

  @@unique([projectId, number])
  @@unique([workspaceId, projectId, id], map: "semantic_versions_tenant_project_id_key")
  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, projectId, parentVersionId], map: "semantic_versions_parent_idx")
  @@map("semantic_versions")
}

model SemanticUndoReceipt {
  workspaceId      String   @map("workspace_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  actorId          String   @map("actor_id") @db.Uuid
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(180)
  sourceVersionId  String   @map("source_version_id") @db.Uuid
  createdVersionId String?  @map("created_version_id") @db.Uuid
  applied          Int
  conflicted       Int
  unsupported      Int
  changes          Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceVersion  SemanticVersion  @relation("SemanticUndoSourceVersion", fields: [workspaceId, projectId, sourceVersionId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  createdVersion SemanticVersion? @relation("SemanticUndoCreatedVersion", fields: [workspaceId, projectId, createdVersionId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([workspaceId, projectId, actorId, idempotencyKey])
  @@index([workspaceId, projectId, sourceVersionId, createdAt(sort: Desc)], map: "semantic_undo_receipts_source_idx")
  @@map("semantic_undo_receipts")
}

model SemanticEntityChange {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  semanticVersionId String   @map("semantic_version_id") @db.Uuid
  entityType        String   @map("entity_type") @db.VarChar(32)
  entityId          String   @map("entity_id") @db.Uuid
  operation         String   @db.VarChar(16)
  beforeState       Json?    @map("before_state")
  afterState        Json     @map("after_state")
  beforeVersion     Int?     @map("before_version")
  afterVersion      Int      @map("after_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  semanticVersion SemanticVersion @relation(fields: [workspaceId, projectId, semanticVersionId], references: [workspaceId, projectId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([semanticVersionId, entityType, entityId], map: "semantic_entity_changes_version_entity_key")
  @@index([workspaceId, projectId, entityType, entityId, createdAt(sort: Desc)], map: "semantic_entity_changes_entity_history_idx")
  @@map("semantic_entity_changes")
}

model SemanticImportReceipt {
  importId                String                      @id @map("import_id") @db.Uuid
  workspaceId             String                      @map("workspace_id") @db.Uuid
  projectId               String                      @map("project_id") @db.Uuid
  actorId                 String                      @map("actor_id") @db.Uuid
  status                  SemanticImportReceiptStatus @default(RECEIVING)
  mappingHash             String                      @map("mapping_hash") @db.Char(64)
  duplicatePolicy         String                      @map("duplicate_policy") @db.VarChar(32)
  createMissingKeywords   Boolean                     @default(true) @map("create_missing_keywords")
  expectedChunks          Int                         @map("expected_chunks")
  expectedUniqueRows      BigInt                      @map("expected_unique_rows")
  planCode                String                      @map("plan_code") @db.VarChar(64)
  planVersion             Int                         @map("plan_version")
  storedKeywordsLimit     BigInt                      @map("stored_keywords_limit")
  keywordsPerProjectLimit BigInt                      @map("keywords_per_project_limit")
  foldersPerProjectLimit  BigInt                      @map("folders_per_project_limit")
  reservedKeywords        BigInt                      @map("reserved_keywords")
  semanticVersionId       String?                     @map("semantic_version_id") @db.Uuid
  resultSummary           Json?                       @map("result_summary")
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt             DateTime?                   @map("completed_at") @db.Timestamptz(6)

  chunks SemanticImportChunkReceipt[]

  @@index([workspaceId, projectId, status, createdAt])
  @@map("semantic_import_receipts")
}

model SemanticImportChunkReceipt {
  importId                   String   @map("import_id") @db.Uuid
  chunkIndex                 Int      @map("chunk_index")
  payloadHash                String   @map("payload_hash") @db.Char(64)
  inputRows                  Int      @map("input_rows")
  createdKeywords            BigInt   @default(0) @map("created_keywords")
  updatedKeywords            BigInt   @default(0) @map("updated_keywords")
  skippedKeywords            BigInt   @default(0) @map("skipped_keywords")
  createdGroups              BigInt   @default(0) @map("created_groups")
  createdPages               BigInt   @default(0) @map("created_pages")
  createdTags                BigInt   @default(0) @map("created_tags")
  createdMetricSnapshots     BigInt   @default(0) @map("created_metric_snapshots")
  trashedDuplicateCandidates Json     @default("[]") @map("trashed_duplicate_candidates")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  semanticImport SemanticImportReceipt @relation(fields: [importId], references: [importId], onDelete: Cascade)

  @@id([importId, chunkIndex])
  @@map("semantic_import_chunk_receipts")
}

model OutboxEvent {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(160)
  aggregateId String       @map("aggregate_id") @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  payload     Json
  metadata    Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}
