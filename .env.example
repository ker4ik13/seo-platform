COMPOSE_PROJECT_NAME=seo-platform

POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-me
NATS_USER=platform
NATS_PASSWORD=replace-me
INTERNAL_API_TOKEN=replace-with-a-shared-random-internal-token
INTERNAL_COMMAND_TIMEOUT_MS=15000
DIRECTUS_SECRET=replace-with-at-least-32-random-characters
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-me

WEB_PUBLIC_URL=https://example.com
ADMIN_PUBLIC_URL=https://admin.example.com
API_PUBLIC_URL=https://api.example.com
REALTIME_PUBLIC_URL=https://realtime.example.com
DIRECTUS_PUBLIC_URL=https://cms.example.com

S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=
S3_BUCKET_ARTIFACTS=
S3_BUCKET_CMS=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_EXPIRES_HOURS=24
UPLOAD_INSPECTION_LEASE_MINUTES=30
UPLOAD_INSPECTION_DISPATCH_SECONDS=30
UPLOAD_INSPECTION_HEARTBEAT_SECONDS=60
UPLOAD_INSPECTION_CONCURRENCY=2

MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_HOST=
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_CONNECT_TIMEOUT_MS=5000
MALWARE_SCANNER_SCAN_TIMEOUT_MS=900000

EMAIL_ENABLED=false
EMAIL_PROVIDER=disabled
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

AUTH_PASSWORD_PEPPER=replace-with-a-long-random-secret
AUTH_ACCESS_COOKIE_NAME=seo_access
AUTH_SESSION_COOKIE_NAME=seo_session
AUTH_CSRF_COOKIE_NAME=seo_csrf
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=30
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
AUTH_RECENT_AUTHENTICATION_MINUTES=10
AUTH_TOTP_ISSUER=SEO Workspace
AUTH_COOKIE_SECURE=true
AUTH_DATA_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
AUTH_EXPOSE_DEVELOPMENT_TOKENS=false
TERMS_VERSION=2026-07-28-draft
PRIVACY_VERSION=2026-07-28-draft
MARKETING_VERSION=2026-07-28-draft

DIRECTUS_STORAGE_DRIVER=local
DIRECTUS_EMAIL_TRANSPORT=sendmail
