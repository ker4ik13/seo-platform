NODE_ENV=development
PORT=4002
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql://platform:replace-me@postgres:5432/jobs_db
DATABASE_POOL_MAX=20
REDIS_URL=redis://:replace-me@redis:6379
NATS_URL=nats://nats:4222
NATS_USER=platform
NATS_PASSWORD=replace-me
INTERNAL_API_TOKEN=replace-with-a-shared-random-internal-token

S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=
S3_BUCKET_ARTIFACTS=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_EXPIRES_HOURS=24

EMAIL_ENABLED=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
