# Canonical Dokploy environment template.
# Recommended: run `pnpm dokploy:env:generate`; it fills every internal secret
# below with a different value and creates `.env.dokploy.generated` (mode 600).
# Manual fallback for EACH URL-safe password/token: `openssl rand -hex 32`.
# Manual fallback for EACH 32-byte base64url key:
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'`.
# Do not paste `$(...)` commands as values: Compose never executes them.
# Every variable is entered once in Dokploy Environment and Compose reuses it
# wherever required. Different secret variable names must have different values.

COMPOSE_PROJECT_NAME=seo-platform
COMPOSE_PROFILES=inspection
SERVICE_VERSION=0.1.0
DEFAULT_LOCALE=ru

# Внутренние runtime-ошибки отправляются через отдельный приватный receiver.
# Токен ниже генерируется `pnpm dokploy:env:generate` автоматически.
TELEGRAM_ALERTS_ENABLED=false
OPERATIONAL_ALERT_TOKEN=
TELEGRAM_ALERT_ENVIRONMENT=production
# ВРУЧНУЮ (только если TELEGRAM_ALERTS_ENABLED=true): токен отдельного bot,
# созданного через BotFather. Никогда не передавайте его frontend/execution.
TELEGRAM_ALERT_BOT_TOKEN=
# ВРУЧНУЮ (только если TELEGRAM_ALERTS_ENABLED=true): числовой chat ID.
TELEGRAM_ALERT_CHAT_ID=
# ВРУЧНУЮ при необходимости: ID topic в Telegram forum; иначе пусто.
TELEGRAM_ALERT_THREAD_ID=

POSTGRES_USER=platform
# Generate once. Enter this exact same value again only in each Dokploy
# PostgreSQL backup job; application DB passwords below remain different.
POSTGRES_PASSWORD=replace-with-a-new-output-of-openssl-rand-hex-32
PLATFORM_DATABASE_OWNER_PASSWORD=replace-with-a-unique-url-safe-platform-owner-password
PLATFORM_DATABASE_PASSWORD=replace-with-a-unique-url-safe-platform-runtime-password
PLATFORM_API_DATABASE_POOL_MAX=20
SEO_DATABASE_OWNER_PASSWORD=replace-with-a-unique-url-safe-seo-owner-password
SEO_DATABASE_PASSWORD=replace-with-a-unique-url-safe-seo-runtime-password
SEO_DATA_DATABASE_POOL_MAX=30
JOBS_DATABASE_OWNER_PASSWORD=replace-with-a-unique-url-safe-jobs-owner-password
JOBS_DATABASE_PASSWORD=replace-with-a-unique-url-safe-jobs-runtime-password
JOBS_DATABASE_POOL_MAX=30
JOBS_INSPECTION_DATABASE_POOL_MAX=10
JOBS_IMPORT_DATABASE_POOL_MAX=10
JOBS_RANK_DATABASE_PASSWORD=replace-with-a-unique-url-safe-jobs-rank-runtime-password
JOBS_AUTH_EMAIL_DATABASE_PASSWORD=replace-with-a-unique-url-safe-jobs-auth-email-runtime-password
REALTIME_DATABASE_OWNER_PASSWORD=replace-with-a-unique-url-safe-realtime-owner-password
REALTIME_DATABASE_PASSWORD=replace-with-a-unique-url-safe-realtime-runtime-password
REALTIME_DATABASE_POOL_MAX=20
REALTIME_WEB_PUSH_DATABASE_PASSWORD=replace-with-a-unique-url-safe-realtime-web-push-runtime-password
REALTIME_WEB_PUSH_DATABASE_POOL_MAX=10

# Generate a new `openssl rand -hex 32` output for every line in this block.
REDIS_JOBS_API_PASSWORD=
REDIS_JOBS_SYSTEM_PASSWORD=
REDIS_JOBS_INSPECTION_PASSWORD=
REDIS_JOBS_IMPORT_PASSWORD=
REDIS_JOBS_RANK_PASSWORD=
REDIS_JOBS_CRAWL_PASSWORD=
REDIS_JOBS_CONNECTOR_PASSWORD=
REDIS_REALTIME_PASSWORD=

# Keep these five usernames. For each identity, PASSWORD is a new value that
# starts with `n`; PASSWORD_HASH is bcrypt 2a/cost-11 of that exact PASSWORD,
# not the same text. In Dokploy each '$' in the hash must be entered as '$$'
# because Dokploy rewrites dotenv before Compose interpolation.
# `pnpm dokploy:env:generate` creates matching, already escaped pairs.
NATS_RUNTIME_USER=seo_runtime
NATS_RUNTIME_PASSWORD=
NATS_RUNTIME_PASSWORD_HASH=
NATS_PLATFORM_PUBLISHER_USER=seo_platform_publisher
NATS_PLATFORM_PUBLISHER_PASSWORD=
NATS_PLATFORM_PUBLISHER_PASSWORD_HASH=
NATS_REALTIME_CONSUMER_USER=seo_realtime_consumer
NATS_REALTIME_CONSUMER_PASSWORD=
NATS_REALTIME_CONSUMER_PASSWORD_HASH=
NATS_AUTH_EMAIL_CONSUMER_USER=seo_auth_email_consumer
NATS_AUTH_EMAIL_CONSUMER_PASSWORD=
NATS_AUTH_EMAIL_CONSUMER_PASSWORD_HASH=
NATS_PROVISIONER_USER=seo_topology_provisioner
NATS_PROVISIONER_PASSWORD=
NATS_PROVISIONER_PASSWORD_HASH=
NATS_EVENT_ENVIRONMENT=production
OUTBOX_PUBLISH_INTERVAL_MS=1000
OUTBOX_PUBLISH_BATCH_SIZE=20
OUTBOX_PUBLISH_MAX_ATTEMPTS=10
OUTBOX_PUBLISH_RETRY_BASE_MS=1000
OUTBOX_PUBLISH_RETRY_MAX_MS=300000
OUTBOX_PUBLISH_ACK_TIMEOUT_MS=5000
SESSION_EXPIRY_SWEEPER_ENABLED=true
SESSION_EXPIRY_SWEEPER_INTERVAL_MS=60000
SESSION_EXPIRY_SWEEPER_BATCH_SIZE=50
SESSION_EXPIRY_SWEEPER_TRANSACTION_TIMEOUT_MS=10000
SESSION_EXPIRY_SWEEPER_LOCK_TIMEOUT_MS=500
NATS_EVENT_FETCH_EXPIRES_MS=30000
NATS_EVENT_MAX_ATTEMPTS=10
NATS_EVENT_RETRY_BASE_MS=1000
NATS_EVENT_RETRY_MAX_MS=300000
NATS_EVENT_PUBLISH_TIMEOUT_MS=5000
NATS_EVENT_MAX_PAYLOAD_BYTES=65536
NATS_EVENT_SHUTDOWN_GRACE_MS=10000
# Generate a new `openssl rand -hex 32` output for every token/cursor line.
PLATFORM_API_TO_SEO_DATA_TOKEN=
PLATFORM_API_TO_JOBS_TOKEN=
JOBS_TO_SEO_DATA_TOKEN=
PLATFORM_API_TO_REALTIME_TOKEN=
JOBS_TO_SEO_RANK_TOKEN=replace-with-a-distinct-random-rank-worker-token
JOBS_TO_PLATFORM_RANK_GRANT_TOKEN=
JOBS_TO_PLATFORM_BILLING_SETTLEMENT_TOKEN=
JOBS_TO_PLATFORM_AUTOMATION_TOKEN=
JOBS_TO_SEO_RANK_RESULT_TOKEN=
JOBS_TO_PLATFORM_AUTH_EMAIL_TOKEN=
RANK_HISTORY_CURSOR_KEY=
PLATFORM_API_TO_JOBS_CREDENTIAL_TOKEN=replace-with-a-distinct-random-credential-token
PLATFORM_API_TO_REALTIME_NOTIFICATION_TOKEN=
REALTIME_TO_PLATFORM_NOTIFICATION_TOKEN=
JOBS_CONNECTOR_DATABASE_PASSWORD=replace-with-a-url-safe-random-password
# These are two different base64url keys. The `1:` prefix must match the two
# ACTIVE_KEY_VERSION=1 values; the encryption and fingerprint keys differ.
INTEGRATION_CREDENTIAL_KEYS=1:replace-with-a-base64url-encoded-32-byte-key
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION=1
INTEGRATION_CREDENTIAL_FINGERPRINT_KEYS=1:replace-with-a-different-base64url-encoded-32-byte-key
INTEGRATION_CREDENTIAL_ACTIVE_FINGERPRINT_KEY_VERSION=1
INTERNAL_COMMAND_TIMEOUT_MS=15000
INTERNAL_REQUEST_TIMEOUT_MS=1500
PLATFORM_API_COMMAND_TIMEOUT_MS=5000
SEO_DATA_COMMAND_TIMEOUT_MS=60000
SYSTEM_WORKER_CONCURRENCY=2
JOBS_RANK_DATABASE_POOL_MAX=5
RANK_WORKER_PROCESSES=2
RANK_PREPARATION_LEASE_SECONDS=120
RANK_PREPARATION_DISPATCH_SECONDS=15
RANK_RESULT_PERSISTENCE_DISPATCH_INTERVAL_MS=1000
RANK_PREPARATION_CONCURRENCY=2
RANK_PROVIDER_SUBMIT_ENABLED=true
RANK_PROVIDER_KILL_SWITCH_VERSION=arsenkin-positions@4
JOBS_CRAWL_DATABASE_POOL_MAX=10
CRAWL_CONCURRENCY=2
CRAWL_DISPATCH_SECONDS=15
CRAWL_LEASE_SECONDS=180
CRAWL_REQUEST_TIMEOUT_MS=20000
CRAWL_MAX_RESPONSE_BYTES=2000000
CRAWL_MAX_REDIRECTS=5
JOBS_AUTH_EMAIL_DATABASE_POOL_MAX=5
AUTH_EMAIL_MAX_ATTEMPTS=10
AUTH_EMAIL_LEASE_SECONDS=120
AUTH_EMAIL_DISPATCH_MS=1000
AUTH_EMAIL_FETCH_EXPIRES_MS=30000
AUTH_EMAIL_PUBLISH_TIMEOUT_MS=5000
AUTH_EMAIL_RETRY_BASE_MS=1000
AUTH_EMAIL_RETRY_MAX_MS=300000
AUTH_EMAIL_MAX_PAYLOAD_BYTES=65536
AUTH_EMAIL_SHUTDOWN_GRACE_MS=10000

# ВРУЧНУЮ (обязательно): публичный HTTPS-адрес frontend без `/` в конце,
# например https://seo.example.com.
WEB_PUBLIC_URL=
# Host без схемы и пути. Запросы к нему получают permanent 308 на
# WEB_PUBLIC_URL с сохранением пути и query string.
WEB_WWW_REDIRECT_HOST=www.seonorita.ru
# ВРУЧНУЮ (обязательно): публичный HTTPS-адрес API без `/` в конце,
# например https://api.seo.example.com.
API_PUBLIC_URL=

YOOKASSA_ENABLED=false
# ВРУЧНУЮ (только если YOOKASSA_ENABLED=true): shop ID из кабинета YooKassa.
YOOKASSA_SHOP_ID=
# ВРУЧНУЮ (только если YOOKASSA_ENABLED=true): secret key из кабинета YooKassa.
YOOKASSA_SECRET_KEY=
# ВРУЧНУЮ (только если YOOKASSA_ENABLED=true): HTTPS return URL после оплаты.
YOOKASSA_RETURN_URL=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_REQUEST_TIMEOUT_MS=10000
YOOKASSA_VALIDATE_WEBHOOK_SOURCE_IP=true
BILLING_RECONCILIATION_ENABLED=false
BILLING_RECONCILIATION_INTERVAL_MS=60000
BILLING_RECONCILIATION_BATCH_SIZE=25

# Платформенные ключи провайдеров позволяют запускать проверки позиций за
# внутренние токены. Цена задаётся в minor units внутреннего баланса за одну
# ключевую фразу; итоговая смета умножает её на точный размер scope. Пока флаг
# false, ключи и цена не используются.
PLATFORM_XMLSTOCK_ENABLED=false
# ВРУЧНУЮ (только если PLATFORM_XMLSTOCK_ENABLED=true): цена одной фразы.
PLATFORM_XMLSTOCK_RANK_KEYWORD_PRICE_MINOR=
# ВРУЧНУЮ при включении: hard caps внутренних token minor units по UTC.
PLATFORM_XMLSTOCK_DAILY_SPEND_LIMIT_MINOR=
PLATFORM_XMLSTOCK_MONTHLY_SPEND_LIMIT_MINOR=
# ВРУЧНУЮ (рекомендуется): API keys XMLStock через запятую, максимум 64.
PLATFORM_XMLSTOCK_API_KEYS=
# ВРУЧНУЮ: один общий account ID либо столько ID, сколько API keys.
PLATFORM_XMLSTOCK_ACCOUNT_IDS=
# Legacy-варианты для одного ключа; не заполнять вместе с plural-вариантами.
PLATFORM_XMLSTOCK_API_KEY=
PLATFORM_XMLSTOCK_ACCOUNT_ID=
PLATFORM_ARSENKIN_ENABLED=false
# ВРУЧНУЮ (только если PLATFORM_ARSENKIN_ENABLED=true): цена одной фразы.
PLATFORM_ARSENKIN_RANK_KEYWORD_PRICE_MINOR=
# ВРУЧНУЮ при включении: hard caps внутренних token minor units по UTC.
PLATFORM_ARSENKIN_DAILY_SPEND_LIMIT_MINOR=
PLATFORM_ARSENKIN_MONTHLY_SPEND_LIMIT_MINOR=
# ВРУЧНУЮ (рекомендуется): API keys Arsenkin через запятую, максимум 64.
PLATFORM_ARSENKIN_API_KEYS=
# Legacy-вариант для одного ключа; не заполнять вместе с plural-вариантом.
PLATFORM_ARSENKIN_API_KEY=

S3_ENABLED=true
# ВРУЧНУЮ: HTTPS endpoint S3-compatible провайдера; для AWS оставить пустым.
S3_ENDPOINT=
# ВРУЧНУЮ (обязательно): регион bucket, например ru-central1 или eu-central-1.
S3_REGION=
# ВРУЧНУЮ (обязательно): application Access Key ID, выданный S3-провайдером.
S3_ACCESS_KEY_ID=
# ВРУЧНУЮ (обязательно): application Secret Access Key от S3-провайдера.
S3_SECRET_ACCESS_KEY=
# ВРУЧНУЮ (обязательно): имя bucket для загружаемых пользователями файлов.
S3_BUCKET_UPLOADS=
# ВРУЧНУЮ (обязательно): имя bucket для результатов/отчётов; может быть тем
# же bucket, что S3_BUCKET_UPLOADS, если вы хотите хранить всё в одном bucket.
S3_BUCKET_ARTIFACTS=
S3_KEY_PREFIX=seo-platform/production/app
# ВРУЧНУЮ при необходимости: true только если S3-провайдер требует path-style.
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_EXPIRES_HOURS=24
UPLOAD_INSPECTION_LEASE_MINUTES=30
UPLOAD_INSPECTION_DISPATCH_SECONDS=30
UPLOAD_INSPECTION_HEARTBEAT_SECONDS=60
UPLOAD_INSPECTION_CONCURRENCY=2

MALWARE_SCANNER_ENABLED=true
MALWARE_SCANNER_CONNECT_TIMEOUT_MS=5000
MALWARE_SCANNER_SCAN_TIMEOUT_MS=900000

IMPORT_PARSE_LEASE_MINUTES=30
IMPORT_PARSE_DISPATCH_SECONDS=30
IMPORT_PARSE_HEARTBEAT_SECONDS=30
IMPORT_PARSE_CONCURRENCY=2
IMPORT_STAGING_BATCH_ROWS=1000
IMPORT_PREVIEW_ROWS=20
IMPORT_PUBLISH_BATCH_ROWS=200
INTEGRATION_VALIDATION_TIMEOUT_MS=10000
INTEGRATION_VALIDATION_LEASE_SECONDS=120
INTEGRATION_VALIDATION_DISPATCH_SECONDS=15
INTEGRATION_VALIDATION_CONCURRENCY=1
JOBS_CONNECTOR_DATABASE_POOL_MAX=12
CONNECTOR_RUNTIME_DISPATCH_INTERVAL_MS=1000
CONNECTOR_WORKER_PROCESSES=3
RANK_CONNECTOR_CONCURRENCY=4
FREQUENCY_COLLECTION_CONCURRENCY=1
KEYWORD_RESEARCH_CONCURRENCY=1

# ВРУЧНУЮ (обязательно): подтверждённый адрес отправителя, например
# no-reply@example.com.
AUTH_EMAIL_FROM=
# ВРУЧНУЮ (обязательно): домен отправителя без `@`, например example.com.
AUTH_EMAIL_MESSAGE_ID_DOMAIN=
# ВРУЧНУЮ (обязательно): SMTP hostname, выданный почтовым провайдером.
AUTH_EMAIL_SMTP_HOST=
# ВРУЧНУЮ: SMTP port провайдера; обычно 587, для implicit TLS обычно 465.
AUTH_EMAIL_SMTP_PORT=587
# ВРУЧНУЮ: false для STARTTLS/587, true для implicit TLS/465.
AUTH_EMAIL_SMTP_SECURE=false
# ВРУЧНУЮ (обязательно): SMTP username из кабинета почтового провайдера.
AUTH_EMAIL_SMTP_USER=
# ВРУЧНУЮ (обязательно): SMTP password/API key из кабинета провайдера.
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
AUTH_EMAIL_SMTP_SOCKET_TIMEOUT_MS=10000

WEB_PUSH_REGISTRATION_ENABLED=false
WEB_PUSH_DELIVERY_AVAILABLE=false
WEB_PUSH_DELIVERY_ENABLED=false
# ВРУЧНУЮ (только при включении Web Push): VAPID public key.
WEB_PUSH_VAPID_PUBLIC_KEY=
# ВРУЧНУЮ (только при включении Web Push): соответствующий VAPID private key.
WEB_PUSH_VAPID_PRIVATE_KEY=
# ВРУЧНУЮ (только при включении Web Push): mailto:admin@example.com или HTTPS URL.
WEB_PUSH_VAPID_SUBJECT=
# ВРУЧНУЮ (только при включении Web Push): версия VAPID key, например 1.
WEB_PUSH_VAPID_KEY_VERSION=
WEB_PUSH_ENDPOINT_ORIGINS=https://fcm.googleapis.com,https://updates.push.services.mozilla.com,https://web.push.apple.com
# ВРУЧНУЮ (только при включении): `1:<base64url-32-byte-key>`.
WEB_PUSH_SUBSCRIPTION_KEYS=
# ВРУЧНУЮ (только при включении): 1, должно совпасть с префиксом keyring выше.
WEB_PUSH_ACTIVE_SUBSCRIPTION_KEY_VERSION=
# ВРУЧНУЮ (только при включении): другой `1:<base64url-32-byte-key>`.
WEB_PUSH_FINGERPRINT_KEYS=
# ВРУЧНУЮ (только при включении): 1, совпадает с fingerprint keyring.
WEB_PUSH_ACTIVE_FINGERPRINT_KEY_VERSION=
WEB_PUSH_MAX_ACTIVE_DEVICES=20
WEB_PUSH_DELIVERY_AUTHORIZATION_TIMEOUT_MS=5000
WEB_PUSH_DELIVERY_MAX_ATTEMPTS=8
WEB_PUSH_DELIVERY_POLL_INTERVAL_MS=1000
WEB_PUSH_DELIVERY_LEASE_MS=30000
WEB_PUSH_DELIVERY_RETRY_BASE_MS=1000
WEB_PUSH_DELIVERY_RETRY_MAX_MS=300000
WEB_PUSH_DELIVERY_SEND_TIMEOUT_MS=10000
WEB_PUSH_DELIVERY_TTL_SECONDS=3600
WEB_PUSH_EXPIRY_SWEEP_INTERVAL_MS=60000
WEB_PUSH_EXPIRY_SWEEP_BATCH_SIZE=100

# Generate separately with `openssl rand -hex 32`.
AUTH_PASSWORD_PEPPER=replace-with-a-new-output-of-openssl-rand-hex-32
AUTH_ACCESS_COOKIE_NAME=seo_access
AUTH_SESSION_COOKIE_NAME=seo_session
AUTH_CSRF_COOKIE_NAME=seo_csrf
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=30
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
AUTH_RECENT_AUTHENTICATION_MINUTES=10
AUTH_TOTP_ISSUER=SEOньорита
AUTH_COOKIE_SECURE=true
# Generate separately with the base64url command from the file header.
AUTH_DATA_ENCRYPTION_KEY=replace-with-a-new-base64url-encoded-32-byte-key
TERMS_VERSION=2026-07-28-draft
PRIVACY_VERSION=2026-07-28-draft
MARKETING_VERSION=2026-07-28-draft
