NODE_ENV=development
PORT=4003
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql://platform:platform@localhost:5432/realtime_db
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=
NATS_EVENT_CONSUMER_ENABLED=false
NATS_EVENT_ENVIRONMENT=development
NATS_EVENT_STREAM=IDENTITY_EVENTS
NATS_EVENT_CONSUMER_DURABLE=realtime_session_family_revoked_v1
NATS_EVENT_DLQ_STREAM=DOMAIN_EVENTS_DLQ
NATS_EVENT_DLQ_SUBJECT=development.dlq.realtime.identity.session-family.revoked.v1
NATS_EVENT_FETCH_EXPIRES_MS=1000
NATS_EVENT_MAX_ATTEMPTS=8
NATS_EVENT_RETRY_BASE_MS=1000
NATS_EVENT_RETRY_MAX_MS=60000
NATS_EVENT_PUBLISH_TIMEOUT_MS=5000
NATS_EVENT_MAX_PAYLOAD_BYTES=65536
NATS_EVENT_SHUTDOWN_GRACE_MS=10000
PLATFORM_API_TO_REALTIME_TOKEN=replace-with-a-distinct-random-platform-api-token
PLATFORM_API_TO_REALTIME_NOTIFICATION_TOKEN=replace-with-a-distinct-random-notification-token
WEB_ORIGINS=http://localhost:3000
WEB_PUSH_REGISTRATION_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_KEY_VERSION=
WEB_PUSH_ENDPOINT_ORIGINS=https://fcm.googleapis.com,https://updates.push.services.mozilla.com,https://web.push.apple.com
WEB_PUSH_SUBSCRIPTION_KEYS=
WEB_PUSH_ACTIVE_SUBSCRIPTION_KEY_VERSION=
WEB_PUSH_FINGERPRINT_KEYS=
WEB_PUSH_ACTIVE_FINGERPRINT_KEY_VERSION=
WEB_PUSH_MAX_ACTIVE_DEVICES=20
