{
  "name": "@seo-platform/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "schemas"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "import": "./dist/canonical-json.js"
    },
    "./rank-results-canonical": {
      "types": "./dist/rank-results-canonical.d.ts",
      "import": "./dist/rank-results-canonical.js"
    },
    "./schemas/identity.session-family.revoked.v1.schema.json":
      "./schemas/identity.session-family.revoked.v1.schema.json",
    "./schemas/identity.session-family.revoked.v1.asyncapi.json":
      "./schemas/identity.session-family.revoked.v1.asyncapi.json",
    "./seo-regions": {
      "types": "./dist/seo-regions.d.ts",
      "import": "./dist/seo-regions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
