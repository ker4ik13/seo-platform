generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CommentStatus {
  OPEN
  RESOLVED
  DELETED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model CollaborationDocument {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  resourceType      String   @map("resource_type") @db.VarChar(64)
  resourceId        String   @map("resource_id") @db.Uuid
  stateVector       Bytes?   @map("state_vector")
  snapshotObjectKey String?  @map("snapshot_object_key") @db.Text
  version           BigInt   @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, resourceType, resourceId])
  @@index([workspaceId, projectId, active])
  @@map("collaboration_documents")
}

model Comment {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  targetType  String        @map("target_type") @db.VarChar(64)
  targetId    String        @map("target_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  body        String        @db.Text
  anchor      Json?
  status      CommentStatus @default(OPEN)
  resolvedBy  String?       @map("resolved_by") @db.Uuid
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, projectId, targetType, targetId, status])
  @@index([parentId])
  @@map("comments")
}

model Notification {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String    @db.VarChar(100)
  title       String    @db.VarChar(255)
  body        String?   @db.Text
  data        Json?
  dedupeKey   String?   @map("dedupe_key") @db.VarChar(180)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, dedupeKey])
  @@index([workspaceId, userId, readAt, createdAt])
  @@map("notifications")
}

model InboxEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(160)
  consumer    String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@index([consumer, processedAt])
  @@map("inbox_events")
}

model OutboxEvent {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(160)
  aggregateId String       @map("aggregate_id") @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  payload     Json
  metadata    Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}
