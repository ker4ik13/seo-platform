generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum DataSourceMode {
  BYOK
  PLATFORM
  IMPORT
  MANUAL
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum SemanticImportReceiptStatus {
  RECEIVING
  COMPLETED
}

enum TrackingContextStatus {
  ACTIVE
  ARCHIVED
}

enum TrackingSearchEngine {
  GOOGLE
  YANDEX
}

enum TrackingDevice {
  DESKTOP
  MOBILE
}

enum TrackingDomainMatchMode {
  EXACT_HOST
  INCLUDE_WWW
  INCLUDE_SUBDOMAINS
  CANONICAL_DOMAIN
  ANY_PROJECT_MIRROR
  SPECIFIC_URL
  URL_PREFIX
}

model Keyword {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  textOriginal   String         @map("text_original") @db.Text
  textNormalized String         @map("text_normalized") @db.Text
  normalizedHash String         @map("normalized_hash") @db.Char(64)
  language       String         @default("und") @db.VarChar(16)
  priority       Int            @default(0)
  status         EntityStatus   @default(ACTIVE)
  clusterId      String?        @map("cluster_id") @db.Uuid
  targetPageId   String?        @map("target_page_id") @db.Uuid
  /// Legacy compatibility field; active tracking assignments are authoritative.
  isTracked      Boolean        @default(false) @map("is_tracked")
  customValues   Json           @default("{}") @map("custom_values")
  sourceMode     DataSourceMode @default(MANUAL) @map("source_mode")
  sourceId       String?        @map("source_id") @db.Uuid
  createdBy      String?        @map("created_by") @db.Uuid
  updatedBy      String?        @map("updated_by") @db.Uuid
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)

  memberships         KeywordGroupMembership[]
  tags                KeywordTag[]
  trackingAssignments TrackingContextKeywordAssignment[]

  @@unique([projectId, language, normalizedHash])
  @@unique([workspaceId, projectId, id], map: "keywords_tenant_project_id_key")
  @@index([workspaceId, projectId, status, id])
  @@index([workspaceId, projectId, status, createdAt(sort: Desc), id(sort: Desc)], map: "keywords_workspace_project_status_created_id_idx")
  @@index([textNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "keywords_text_normalized_trgm_idx")
  @@index([projectId, clusterId, id])
  @@index([projectId, targetPageId, id])
  @@index([projectId, isTracked, id])
  @@map("keywords")
}

model KeywordGroup {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  name        String       @db.VarChar(255)
  path        String?      @db.Text
  pathHash    String?      @map("path_hash") @db.Char(64)
  color       String?      @db.VarChar(16)
  position    Int          @default(0)
  status      EntityStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships KeywordGroupMembership[]

  @@unique([projectId, pathHash])
  @@index([projectId, parentId, position])
  @@map("keyword_groups")
}

model KeywordGroupMembership {
  projectId String   @map("project_id") @db.Uuid
  keywordId String   @map("keyword_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  keyword Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  group   KeywordGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([keywordId, groupId])
  @@index([projectId, groupId, keywordId])
  @@map("keyword_group_memberships")
}

model Tag {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  name           String       @db.VarChar(160)
  normalizedName String       @map("normalized_name") @db.VarChar(160)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  keywords KeywordTag[]

  @@unique([projectId, normalizedName])
  @@index([workspaceId, projectId, status, name])
  @@map("tags")
}

model KeywordTag {
  projectId String   @map("project_id") @db.Uuid
  keywordId String   @map("keyword_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([keywordId, tagId])
  @@index([projectId, tagId, keywordId])
  @@map("keyword_tags")
}

model Cluster {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  name        String       @db.VarChar(255)
  method      String       @db.VarChar(64)
  evidence    Json?
  status      EntityStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status, id])
  @@map("clusters")
}

model Page {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  url           String       @db.Text
  normalizedUrl String       @map("normalized_url") @db.Text
  urlHash       String       @map("url_hash") @db.Char(64)
  title         String?      @db.Text
  contentStatus String?      @map("content_status") @db.VarChar(64)
  status        EntityStatus @default(ACTIVE)
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, urlHash])
  @@index([workspaceId, projectId, status, id])
  @@map("pages")
}

model TrackingContext {
  id          String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  projectId   String                @map("project_id") @db.Uuid
  name        String                @db.VarChar(160)
  status      TrackingContextStatus @default(ACTIVE)
  createdBy   String                @map("created_by") @db.Uuid
  updatedBy   String                @map("updated_by") @db.Uuid
  archivedBy  String?               @map("archived_by") @db.Uuid
  version     Int                   @default(1)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime?             @map("archived_at") @db.Timestamptz(6)

  configurations     TrackingContextVersion[]
  keywordAssignments TrackingContextKeywordAssignment[]
  createReceipts     TrackingContextCreateReceipt[]

  @@unique([workspaceId, projectId, id], map: "tracking_contexts_tenant_project_id_key")
  @@index([workspaceId, projectId, status, createdAt, id], map: "tracking_contexts_tenant_project_status_created_idx")
  @@map("tracking_contexts")
}

model TrackingContextVersion {
  workspaceId          String                  @map("workspace_id") @db.Uuid
  projectId            String                  @map("project_id") @db.Uuid
  contextId            String                  @map("context_id") @db.Uuid
  configurationVersion Int                     @map("configuration_version")
  searchEngine         TrackingSearchEngine    @map("search_engine")
  countryCode          String                  @map("country_code") @db.Char(2)
  regionCode           String?                 @map("region_code") @db.VarChar(100)
  regionLabel          String?                 @map("region_label") @db.VarChar(160)
  language             String                  @db.VarChar(16)
  device               TrackingDevice
  depth                Int
  domainMatchMode      TrackingDomainMatchMode @map("domain_match_mode")
  domainMatchValue     String?                 @map("domain_match_value") @db.Text
  safeSearch           Boolean                 @map("safe_search")
  configurationHash    String                  @map("configuration_hash") @db.Char(64)
  createdBy            String                  @map("created_by") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  context TrackingContext @relation(fields: [workspaceId, projectId, contextId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Cascade, map: "tracking_context_versions_context_tenant_fkey")

  @@id([contextId, configurationVersion])
  @@unique([workspaceId, projectId, contextId, configurationVersion], map: "tracking_context_versions_tenant_project_context_version_key")
  @@index([workspaceId, projectId, contextId, configurationVersion(sort: Desc)], map: "tracking_context_versions_current_idx")
  @@map("tracking_context_versions")
}

model TrackingContextKeywordAssignment {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  contextId   String    @map("context_id") @db.Uuid
  keywordId   String    @map("keyword_id") @db.Uuid
  assignedBy  String    @map("assigned_by") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  removedBy   String?   @map("removed_by") @db.Uuid
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(6)

  context TrackingContext @relation(fields: [workspaceId, projectId, contextId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Cascade, map: "tracking_context_assignments_context_tenant_fkey")
  keyword Keyword         @relation(fields: [workspaceId, projectId, keywordId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Cascade, map: "tracking_context_assignments_keyword_tenant_fkey")

  @@index([workspaceId, projectId, contextId, removedAt, assignedAt(sort: Desc), id(sort: Desc)], map: "tracking_context_assignments_context_current_idx")
  @@index([workspaceId, projectId, keywordId, removedAt, contextId], map: "tracking_context_assignments_keyword_current_idx")
  @@map("tracking_context_keyword_assignments")
}

model TrackingContextCreateReceipt {
  workspaceId      String   @map("workspace_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  actorId          String   @map("actor_id") @db.Uuid
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(180)
  requestHash      Bytes    @map("request_hash")
  contextId        String   @map("context_id") @db.Uuid
  responseSnapshot Json     @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  context TrackingContext @relation(fields: [workspaceId, projectId, contextId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Cascade, map: "tracking_context_create_receipts_context_tenant_fkey")

  @@id([workspaceId, projectId, actorId, idempotencyKey])
  @@index([workspaceId, projectId, contextId], map: "tracking_context_create_receipts_context_idx")
  @@map("tracking_context_create_receipts")
}

model RankSnapshot {
  id                String         @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  projectId         String         @map("project_id") @db.Uuid
  keywordId         String         @map("keyword_id") @db.Uuid
  trackingContextId String         @map("tracking_context_id") @db.Uuid
  observedAt        DateTime       @map("observed_at") @db.Timestamptz(6)
  position          Int?
  resultUrl         String?        @map("result_url") @db.Text
  provider          String         @db.VarChar(64)
  sourceMode        DataSourceMode @map("source_mode")
  jobId             String         @map("job_id") @db.Uuid
  metadata          Json?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([observedAt, id])
  @@index([projectId, trackingContextId, observedAt])
  @@index([projectId, keywordId, trackingContextId, observedAt])
  @@map("rank_snapshots")
}

model CurrentRank {
  projectId         String         @map("project_id") @db.Uuid
  keywordId         String         @map("keyword_id") @db.Uuid
  trackingContextId String         @map("tracking_context_id") @db.Uuid
  observedAt        DateTime       @map("observed_at") @db.Timestamptz(6)
  position          Int?
  resultUrl         String?        @map("result_url") @db.Text
  provider          String         @db.VarChar(64)
  sourceMode        DataSourceMode @map("source_mode")
  snapshotId        String         @map("snapshot_id") @db.Uuid
  version           Int            @default(1)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([keywordId, trackingContextId])
  @@index([projectId, trackingContextId, position])
  @@map("current_ranks")
}

model FrequencySnapshot {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  keywordId   String         @map("keyword_id") @db.Uuid
  type        String         @db.VarChar(64)
  regionCode  String         @map("region_code") @db.VarChar(100)
  value       BigInt?
  observedAt  DateTime       @map("observed_at") @db.Timestamptz(6)
  provider    String         @db.VarChar(64)
  sourceMode  DataSourceMode @map("source_mode")
  jobId       String         @map("job_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, keywordId, type, regionCode, observedAt])
  @@map("frequency_snapshots")
}

model SemanticVersion {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  number      Int
  reason      String   @db.VarChar(160)
  actorId     String   @map("actor_id") @db.Uuid
  manifest    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, number])
  @@index([workspaceId, projectId, createdAt])
  @@map("semantic_versions")
}

model SemanticImportReceipt {
  importId           String                      @id @map("import_id") @db.Uuid
  workspaceId        String                      @map("workspace_id") @db.Uuid
  projectId          String                      @map("project_id") @db.Uuid
  actorId            String                      @map("actor_id") @db.Uuid
  status             SemanticImportReceiptStatus @default(RECEIVING)
  mappingHash        String                      @map("mapping_hash") @db.Char(64)
  duplicatePolicy    String                      @map("duplicate_policy") @db.VarChar(32)
  expectedChunks     Int                         @map("expected_chunks")
  expectedUniqueRows BigInt                      @map("expected_unique_rows")
  semanticVersionId  String?                     @map("semantic_version_id") @db.Uuid
  resultSummary      Json?                       @map("result_summary")
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt        DateTime?                   @map("completed_at") @db.Timestamptz(6)

  chunks SemanticImportChunkReceipt[]

  @@index([workspaceId, projectId, status, createdAt])
  @@map("semantic_import_receipts")
}

model SemanticImportChunkReceipt {
  importId               String   @map("import_id") @db.Uuid
  chunkIndex             Int      @map("chunk_index")
  payloadHash            String   @map("payload_hash") @db.Char(64)
  inputRows              Int      @map("input_rows")
  createdKeywords        BigInt   @default(0) @map("created_keywords")
  updatedKeywords        BigInt   @default(0) @map("updated_keywords")
  skippedKeywords        BigInt   @default(0) @map("skipped_keywords")
  createdGroups          BigInt   @default(0) @map("created_groups")
  createdPages           BigInt   @default(0) @map("created_pages")
  createdTags            BigInt   @default(0) @map("created_tags")
  createdMetricSnapshots BigInt   @default(0) @map("created_metric_snapshots")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  semanticImport SemanticImportReceipt @relation(fields: [importId], references: [importId], onDelete: Cascade)

  @@id([importId, chunkIndex])
  @@map("semantic_import_chunk_receipts")
}

model OutboxEvent {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(160)
  aggregateId String       @map("aggregate_id") @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  payload     Json
  metadata    Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}
