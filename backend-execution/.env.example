NODE_ENV=development
BIND_ADDRESS=127.0.0.1
PORT=4002
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql://platform:replace-me@postgres:5432/jobs_db
DATABASE_POOL_MAX=26
REDIS_URL=redis://:replace-me@redis:6379
SYSTEM_WORKER_CONCURRENCY=2
NATS_URL=nats://nats:4222
NATS_USER=platform
NATS_PASSWORD=replace-me
AUTH_EMAIL_EVENT_ENVIRONMENT=development
PLATFORM_API_TO_JOBS_TOKEN=replace-with-a-distinct-random-platform-api-token
JOBS_TO_SEO_DATA_TOKEN=replace-with-a-distinct-random-seo-data-token
PLATFORM_API_TO_JOBS_CREDENTIAL_TOKEN=replace-with-a-distinct-random-credential-token
PLATFORM_API_COMMAND_TIMEOUT_MS=5000
PLATFORM_API_URL=http://backend-core:4000
JOBS_TO_PLATFORM_RANK_GRANT_TOKEN=
JOBS_TO_PLATFORM_BILLING_SETTLEMENT_TOKEN=
JOBS_TO_PLATFORM_AUTOMATION_TOKEN=
JOBS_TO_PLATFORM_AUTH_EMAIL_TOKEN=
SEO_DATA_COMMAND_TIMEOUT_MS=60000
SEO_DATA_URL=http://seo-data:4001
RANK_PREPARATION_ENABLED=false
JOBS_TO_SEO_RANK_TOKEN=
RANK_PREPARATION_LEASE_SECONDS=120
RANK_PREPARATION_DISPATCH_SECONDS=15
RANK_RESULT_PERSISTENCE_DISPATCH_INTERVAL_MS=1000
RANK_PREPARATION_CONCURRENCY=2
RANK_WORKER_PROCESSES=1
RANK_PROVIDER_SUBMIT_ENABLED=true
RANK_PROVIDER_KILL_SWITCH_VERSION=arsenkin-positions@4
INTEGRATION_CREDENTIAL_ROLE=MANAGEMENT
INTEGRATION_CREDENTIAL_KEYS=1:replace-with-a-base64url-encoded-32-byte-key
INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION=1
INTEGRATION_CREDENTIAL_FINGERPRINT_KEYS=1:replace-with-a-different-base64url-encoded-32-byte-key
INTEGRATION_CREDENTIAL_ACTIVE_FINGERPRINT_KEY_VERSION=1
INTEGRATION_VALIDATION_TIMEOUT_MS=10000
INTEGRATION_VALIDATION_LEASE_SECONDS=120
INTEGRATION_VALIDATION_DISPATCH_SECONDS=15
INTEGRATION_VALIDATION_CONCURRENCY=2
CONNECTOR_RUNTIME_DISPATCH_INTERVAL_MS=1000
CONNECTOR_WORKER_PROCESSES=3
RANK_CONNECTOR_CONCURRENCY=16
FREQUENCY_COLLECTION_CONCURRENCY=4
KEYWORD_RESEARCH_CONCURRENCY=2

S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=
S3_BUCKET_ARTIFACTS=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_EXPIRES_HOURS=24
UPLOAD_FILE_RETENTION_DAYS=30
EXPORT_FILE_RETENTION_DAYS=7
UPLOAD_INSPECTION_LEASE_MINUTES=30
UPLOAD_INSPECTION_DISPATCH_SECONDS=30
UPLOAD_INSPECTION_HEARTBEAT_SECONDS=60
UPLOAD_INSPECTION_CONCURRENCY=2

MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_HOST=
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_CONNECT_TIMEOUT_MS=5000
MALWARE_SCANNER_SCAN_TIMEOUT_MS=900000

IMPORT_PARSE_LEASE_MINUTES=30
IMPORT_PARSE_DISPATCH_SECONDS=30
IMPORT_PARSE_HEARTBEAT_SECONDS=30
IMPORT_PARSE_CONCURRENCY=2
IMPORT_STAGING_BATCH_ROWS=5000
IMPORT_PREVIEW_ROWS=20
IMPORT_PUBLISH_BATCH_ROWS=5000

EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_MESSAGE_ID_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
