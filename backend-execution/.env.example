AUTH_EMAIL_FETCH_EXPIRES_MS=30000
AUTH_EMAIL_PUBLISH_TIMEOUT_MS=5000
AUTH_EMAIL_RETRY_BASE_MS=1000
AUTH_EMAIL_RETRY_MAX_MS=300000
AUTH_EMAIL_MAX_PAYLOAD_BYTES=65536
AUTH_EMAIL_SHUTDOWN_GRACE_MS=10000
