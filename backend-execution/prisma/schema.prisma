generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  DRAFT
  ESTIMATING
  AWAITING_APPROVAL
  RESERVING_BALANCE
  PREPARING
  QUEUED
  WAITING_RATE_LIMIT
  RUNNING
  PAUSE_REQUESTED
  PAUSED
  CANCEL_REQUESTED
  CANCELLED
  RETRY_SCHEDULED
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
  ACTION_REQUIRED
  EXPIRED
}

enum JobItemStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
  CANCELLED
}

enum CredentialMode {
  BYOK_API_KEY
  BYOK_OAUTH
  PLATFORM_INCLUDED
  PLATFORM_PAID
  FALLBACK_PLATFORM_PAID
}

enum CredentialStatus {
  PENDING_VERIFICATION
  ACTIVE
  DEGRADED
  RATE_LIMITED
  LOW_BALANCE
  EXPIRED
  REVOKED
  INVALID
  DISABLED
}

enum ProjectConnectorRouteSourceKind {
  WORKSPACE_CREDENTIAL
}

enum UploadStatus {
  INITIATED
  UPLOADING
  UPLOADED
  SCANNING
  READY
  REJECTED
  EXPIRED
  ABORTED
}

enum SemanticImportStatus {
  QUEUED
  PARSING
  AWAITING_MAPPING
  VALIDATING
  AWAITING_CONFIRMATION
  READY_TO_PUBLISH
  PUBLISHING
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum RankManifestSealState {
  PENDING
  OUTCOME_UNKNOWN
  NOT_SEALED
  SEALED
  FINALIZED
}

enum RankCheckFinalStatus {
  COMPLETED
  PARTIALLY_COMPLETED
  CANCELLED
  FAILED
  ACTION_REQUIRED
}

enum RankExecutionGrantAttemptStatus {
  REQUESTED
  DENIED
  GRANTED_PENDING_CONSUME
  EXPIRED
  CONSUMED
  REJECTED_LOCAL
}

enum RankConnectorExecutionStatus {
  READY_TO_SUBMIT
  CLAIMED
  SUBMITTING
  SUBMIT_OUTCOME_UNKNOWN
  POLL_WAIT
  FETCHING
  STAGED
  PERSISTING
  PERSISTED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum AuthEmailDeliveryStatus {
  PENDING
  SENDING
  RETRY_SCHEDULED
  SMTP_ACCEPTED
  DLQ_PENDING
  COMPLETED
  CANCELLED
  FAILED_FINAL
}

enum TechnicalCrawlStatus {
  QUEUED
  RUNNING
  CANCEL_REQUESTED
  CANCELLED
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
}

enum KeywordResearchStatus {
  QUEUED
  RUNNING
  RETRY_SCHEDULED
  READY_TO_IMPORT
  IMPORT_QUEUED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

model Job {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId          String         @map("workspace_id") @db.Uuid
  projectId            String?        @map("project_id") @db.Uuid
  type                 String         @db.VarChar(100)
  status               JobStatus      @default(DRAFT)
  stage                String?        @db.VarChar(64)
  priority             Int            @default(100)
  actorId              String?        @map("actor_id") @db.Uuid
  scheduleId           String?        @map("schedule_id") @db.Uuid
  parentJobId          String?        @map("parent_job_id") @db.Uuid
  deduplicationKey     String?        @map("deduplication_key") @db.VarChar(180)
  idempotencyScope     String         @map("idempotency_scope") @db.VarChar(180)
  idempotencyKey       String?        @map("idempotency_key") @db.VarChar(180)
  requestHash          Bytes?         @map("request_hash")
  inputSnapshot        Json           @map("input_snapshot")
  scopeSnapshot        Json           @map("scope_snapshot")
  progressCurrent      BigInt         @default(0) @map("progress_current")
  progressTotal        BigInt?        @map("progress_total")
  progressUnit         String?        @map("progress_unit") @db.VarChar(32)
  estimatedCostMicro   BigInt?        @map("estimated_cost_micro")
  reservedCostMicro    BigInt?        @map("reserved_cost_micro")
  actualCostMicro      BigInt?        @map("actual_cost_micro")
  currency             String?        @db.Char(3)
  credentialMode       CredentialMode @map("credential_mode")
  provider             String?        @db.VarChar(64)
  attempt              Int            @default(0)
  maxAttempts          Int            @default(3) @map("max_attempts")
  errorSummary         Json?          @map("error_summary")
  resultSummary        Json?          @map("result_summary")
  correlationId        String         @map("correlation_id") @db.VarChar(100)
  version              Int            @default(1)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  queuedAt             DateTime?      @map("queued_at") @db.Timestamptz(6)
  startedAt            DateTime?      @map("started_at") @db.Timestamptz(6)
  finishedAt           DateTime?      @map("finished_at") @db.Timestamptz(6)
  cancelRequestedAt    DateTime?      @map("cancel_requested_at") @db.Timestamptz(6)
  leaseOwner           String?        @map("lease_owner") @db.VarChar(100)
  leaseExpiresAt       DateTime?      @map("lease_expires_at") @db.Timestamptz(6)
  validationLeaseToken String?        @map("validation_lease_token") @db.Uuid
  retryAt              DateTime?      @map("retry_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  items                             JobItem[]
  rankRun                           RankJobRun?
  rankExecutionGrantAttempts        RankExecutionGrantAttempt[]
  rankProviderRequestIntents        RankProviderRequestIntent[]
  rankConnectorExecutions           RankConnectorExecution[]    @relation("RankConnectorExecutionJob")
  rankConnectorValidationExecutions RankConnectorExecution[]    @relation("RankConnectorExecutionValidationJob")
  automationRuns                    AutomationRun[]
  crawlAutomationRuns               CrawlAutomationRun[]
  technicalCrawl                    TechnicalCrawl?
  keywordResearchRun                KeywordResearchRun?

  @@unique([workspaceId, idempotencyScope, idempotencyKey])
  @@unique([workspaceId, id], map: "jobs_tenant_id_key")
  @@unique([workspaceId, projectId, id], map: "jobs_tenant_project_id_key")
  @@index([workspaceId, projectId, status, createdAt])
  @@index([status, priority, createdAt])
  @@index([workspaceId, deduplicationKey, status])
  @@index([type, status, leaseExpiresAt, createdAt])
  @@index([type, status, retryAt, priority, createdAt])
  @@map("jobs")
}

model TechnicalCrawl {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String               @map("workspace_id") @db.Uuid
  projectId         String               @map("project_id") @db.Uuid
  jobId             String               @unique @map("job_id") @db.Uuid
  actorId           String               @map("actor_id") @db.Uuid
  host              String               @db.VarChar(253)
  config            Json
  checkpoint        Json?
  status            TechnicalCrawlStatus @default(QUEUED)
  discoveredUrls    Int                  @default(0) @map("discovered_urls")
  processedUrls     Int                  @default(0) @map("processed_urls")
  successfulUrls    Int                  @default(0) @map("successful_urls")
  failedUrls        Int                  @default(0) @map("failed_urls")
  issueCount        Int                  @default(0) @map("issue_count")
  failureCode       String?              @map("failure_code") @db.VarChar(64)
  backoffCode       String?              @map("backoff_code") @db.VarChar(64)
  backoffUntil      DateTime?            @map("backoff_until") @db.Timestamptz(6)
  version           Int                  @default(1)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt         DateTime?            @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?            @map("finished_at") @db.Timestamptz(6)
  cancelRequestedAt DateTime?            @map("cancel_requested_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  job            Job                  @relation(fields: [workspaceId, projectId, jobId], references: [workspaceId, projectId, id], onDelete: Cascade, onUpdate: Restrict, map: "technical_crawls_job_tenant_fkey")
  automationRuns CrawlAutomationRun[]

  @@unique([workspaceId, projectId, id], map: "technical_crawls_tenant_project_id_key")
  @@unique([workspaceId, projectId, jobId], map: "technical_crawls_tenant_project_job_key")
  @@index([workspaceId, projectId, createdAt(sort: Desc)], map: "technical_crawls_project_created_idx")
  @@index([status, createdAt], map: "technical_crawls_status_created_idx")
  @@index([status, backoffUntil, createdAt], map: "technical_crawls_status_backoff_idx")
  @@map("technical_crawls")
}

model CrawlHostState {
  host                String    @id @db.VarChar(253)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  backoffUntil        DateTime? @map("backoff_until") @db.Timestamptz(6)
  lastFailureCode     String?   @map("last_failure_code") @db.VarChar(64)
  lastStatusCode      Int?      @map("last_status_code")
  lastFailureAt       DateTime? @map("last_failure_at") @db.Timestamptz(6)
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(6)
  latencyEwmaMs       Int?      @map("latency_ewma_ms")
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([backoffUntil], map: "crawl_host_states_backoff_idx")
  @@map("crawl_host_states")
}

model JobItem {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  projectId         String?       @map("project_id") @db.Uuid
  jobId             String        @map("job_id") @db.Uuid
  sequence          Int
  status            JobItemStatus @default(PENDING)
  inputReference    Json          @map("input_reference")
  providerRequestId String?       @map("provider_request_id") @db.VarChar(255)
  outputReference   Json?         @map("output_reference")
  actualCostMicro   BigInt?       @map("actual_cost_micro")
  error             Json?
  attempt           Int           @default(0)
  retryAt           DateTime?     @map("retry_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  job                        Job                         @relation(fields: [workspaceId, jobId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Restrict, map: "job_items_job_tenant_fkey")
  rankExecutionGrantAttempts RankExecutionGrantAttempt[]
  rankProviderRequestIntents RankProviderRequestIntent[]
  rankConnectorExecutions    RankConnectorExecution[]

  @@unique([jobId, sequence])
  @@unique([workspaceId, projectId, jobId, id], map: "job_items_tenant_job_id_key")
  @@index([workspaceId, status, retryAt])
  @@map("job_items")
}

model IntegrationCredential {
  id                    String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId           String           @map("workspace_id") @db.Uuid
  provider              String           @db.VarChar(64)
  label                 String           @db.VarChar(160)
  mode                  CredentialMode
  status                CredentialStatus @default(PENDING_VERIFICATION)
  ciphertext            Bytes
  nonce                 Bytes
  authTag               Bytes            @map("auth_tag")
  encryptedDataKey      Bytes            @map("encrypted_data_key")
  dataKeyNonce          Bytes            @map("data_key_nonce")
  dataKeyAuthTag        Bytes            @map("data_key_auth_tag")
  keyVersion            Int              @map("key_version")
  displayHint           String?          @map("display_hint") @db.VarChar(100)
  capabilities          Json
  providerMeta          Json?            @map("provider_meta")
  idempotencyKey        String           @map("idempotency_key") @db.VarChar(255)
  requestFingerprint    Bytes            @map("request_fingerprint")
  fingerprintKeyVersion Int              @map("fingerprint_key_version")
  materialVersion       Int              @default(1) @map("material_version")
  createdBy             String?          @map("created_by") @db.Uuid
  updatedBy             String?          @map("updated_by") @db.Uuid
  verifiedAt            DateTime?        @map("verified_at") @db.Timestamptz(6)
  lastSuccessAt         DateTime?        @map("last_success_at") @db.Timestamptz(6)
  lastErrorAt           DateTime?        @map("last_error_at") @db.Timestamptz(6)
  lastErrorCode         String?          @map("last_error_code") @db.VarChar(100)
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?        @map("deleted_at") @db.Timestamptz(6)

  connectorRoutes          ProjectConnectorRoute[]
  workspaceConnectorRoutes WorkspaceConnectorRoute[]
  rankConnectorExecutions  RankConnectorExecution[]
  keywordResearchRuns      KeywordResearchRun[]

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, provider, status])
  @@index([workspaceId, createdAt, id])
  @@index([keyVersion, deletedAt, id])
  @@index([fingerprintKeyVersion, deletedAt, id])
  @@map("integration_credentials")
}

model IntegrationCredentialKekCanary {
  keyVersion       Int      @id @map("key_version")
  ciphertext       Bytes
  nonce            Bytes
  authTag          Bytes    @map("auth_tag")
  encryptedDataKey Bytes    @map("encrypted_data_key")
  dataKeyNonce     Bytes    @map("data_key_nonce")
  dataKeyAuthTag   Bytes    @map("data_key_auth_tag")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("integration_credential_kek_canaries")
}

model ProjectConnectorBinding {
  id                      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId             String   @map("workspace_id") @db.Uuid
  projectId               String   @map("project_id") @db.Uuid
  capability              String   @db.VarChar(100)
  enabled                 Boolean  @default(true)
  fallbackMode            String   @default("NONE") @map("fallback_mode") @db.VarChar(48)
  fallbackReasons         Json     @default("[]") @map("fallback_reasons")
  configurationScope      String   @default("PROJECT_OVERRIDE") @map("configuration_scope") @db.VarChar(32)
  workspaceBindingId      String?  @map("workspace_binding_id") @db.Uuid
  workspaceBindingVersion Int?     @map("workspace_binding_version")
  createdBy               String   @map("created_by") @db.Uuid
  updatedBy               String   @map("updated_by") @db.Uuid
  version                 Int      @default(1)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  routes                  ProjectConnectorRoute[]
  workspaceBinding        WorkspaceConnectorBinding?            @relation(fields: [workspaceId, workspaceBindingId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "project_connector_bindings_workspace_binding_fkey")
  createReceipt           ProjectConnectorBindingCreateReceipt?
  rankConnectorExecutions RankConnectorExecution[]
  keywordResearchRuns     KeywordResearchRun[]

  @@unique([workspaceId, projectId, capability], map: "project_connector_bindings_tenant_project_capability_key")
  @@unique([workspaceId, projectId, id], map: "project_connector_bindings_tenant_project_id_key")
  @@index([workspaceId, projectId, createdAt, id], map: "project_connector_bindings_tenant_project_created_idx")
  @@map("project_connector_bindings")
}

model WorkspaceConnectorBinding {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  capability      String   @db.VarChar(100)
  enabled         Boolean  @default(true)
  fallbackMode    String   @default("NONE") @map("fallback_mode") @db.VarChar(48)
  fallbackReasons Json     @default("[]") @map("fallback_reasons")
  createdBy       String   @map("created_by") @db.Uuid
  updatedBy       String   @map("updated_by") @db.Uuid
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  routes                   WorkspaceConnectorRoute[]
  inheritedProjectBindings ProjectConnectorBinding[]

  @@unique([workspaceId, capability], map: "workspace_connector_bindings_workspace_capability_key")
  @@unique([workspaceId, id], map: "workspace_connector_bindings_workspace_id_key")
  @@index([workspaceId, createdAt, id], map: "workspace_connector_bindings_workspace_created_idx")
  @@map("workspace_connector_bindings")
}

model WorkspaceConnectorRoute {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  bindingId    String   @map("binding_id") @db.Uuid
  position     Int
  credentialId String   @map("credential_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  binding    WorkspaceConnectorBinding @relation(fields: [workspaceId, bindingId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Restrict, map: "workspace_connector_routes_binding_workspace_fkey")
  credential IntegrationCredential     @relation(fields: [workspaceId, credentialId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "workspace_connector_routes_credential_workspace_fkey")

  @@unique([workspaceId, bindingId, position], map: "workspace_connector_routes_workspace_binding_position_key")
  @@unique([workspaceId, bindingId, credentialId], map: "workspace_connector_routes_workspace_binding_credential_key")
  @@index([workspaceId, credentialId], map: "workspace_connector_routes_workspace_credential_idx")
  @@map("workspace_connector_routes")
}

model ProjectConnectorBindingCreateReceipt {
  workspaceId      String   @map("workspace_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(180)
  requestHash      Bytes    @map("request_hash")
  bindingId        String   @map("binding_id") @db.Uuid
  responseSnapshot Json     @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  binding ProjectConnectorBinding @relation(fields: [workspaceId, projectId, bindingId], references: [workspaceId, projectId, id], onDelete: Restrict, map: "project_connector_binding_receipts_binding_tenant_fkey")

  @@id([workspaceId, projectId, idempotencyKey])
  @@unique([workspaceId, projectId, bindingId], map: "project_connector_binding_receipts_tenant_project_binding_key")
  @@map("project_connector_binding_create_receipts")
}

model ProjectConnectorRoute {
  id               String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String                          @map("workspace_id") @db.Uuid
  projectId        String                          @map("project_id") @db.Uuid
  bindingId        String                          @map("binding_id") @db.Uuid
  position         Int
  sourceKind       ProjectConnectorRouteSourceKind @map("source_kind")
  credentialId     String                          @map("credential_id") @db.Uuid
  routingScope     String                          @default("PROJECT_OVERRIDE") @map("routing_scope") @db.VarChar(32)
  workspaceRouteId String?                         @map("workspace_route_id") @db.Uuid
  retiredAt        DateTime?                       @map("retired_at") @db.Timestamptz(6)
  createdAt        DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  binding                 ProjectConnectorBinding  @relation(fields: [workspaceId, projectId, bindingId], references: [workspaceId, projectId, id], onDelete: Restrict, map: "project_connector_routes_binding_tenant_fkey")
  credential              IntegrationCredential    @relation(fields: [workspaceId, credentialId], references: [workspaceId, id], onDelete: Restrict, map: "project_connector_routes_credential_tenant_fkey")
  rankConnectorExecutions RankConnectorExecution[]
  keywordResearchRuns     KeywordResearchRun[]

  @@unique([workspaceId, projectId, bindingId, id], map: "project_connector_routes_tenant_project_binding_id_key")
  @@index([workspaceId, credentialId], map: "project_connector_routes_tenant_credential_idx")
  @@index([workspaceId, projectId, bindingId, retiredAt], map: "project_connector_routes_tenant_retired_idx")
  @@map("project_connector_routes")
}

model RankEstimate {
  id                                   String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId                          String            @map("workspace_id") @db.Uuid
  projectId                            String            @map("project_id") @db.Uuid
  actorId                              String            @map("actor_id") @db.Uuid
  trackingContextId                    String            @map("tracking_context_id") @db.Uuid
  idempotencyScope                     String            @map("idempotency_scope") @db.VarChar(180)
  idempotencyKey                       String            @map("idempotency_key") @db.VarChar(180)
  requestHash                          Bytes             @map("request_hash")
  projectVersion                       Int               @map("project_version")
  projectDomainHash                    Bytes             @map("project_domain_hash")
  contextVersion                       Int               @map("context_version")
  configurationVersion                 Int               @map("configuration_version")
  configurationHash                    Bytes             @map("configuration_hash")
  semanticScopeHash                    Bytes?            @map("semantic_scope_hash")
  scopeHash                            Bytes?            @map("scope_hash")
  bindingId                            String?           @map("binding_id") @db.Uuid
  bindingVersion                       Int?              @map("binding_version")
  routeId                              String?           @map("route_id") @db.Uuid
  credentialId                         String?           @map("credential_id") @db.Uuid
  credentialStatus                     CredentialStatus? @map("credential_status")
  credentialVersion                    Int?              @map("credential_version")
  credentialMaterialVersion            Int?              @map("credential_material_version")
  credentialDeletedAt                  DateTime?         @map("credential_deleted_at") @db.Timestamptz(6)
  credentialValidationId               String?           @map("credential_validation_id") @db.Uuid
  credentialValidationVersion          Int?              @map("credential_validation_version")
  credentialValidationConnectorVersion String?           @map("credential_validation_connector_version") @db.VarChar(64)
  credentialValidationFinishedAt       DateTime?         @map("credential_validation_finished_at") @db.Timestamptz(6)
  credentialVerifiedAt                 DateTime?         @map("credential_verified_at") @db.Timestamptz(6)
  provider                             String            @db.VarChar(64)
  credentialMode                       CredentialMode    @map("credential_mode")
  providerPolicyVersion                String            @map("provider_policy_version") @db.VarChar(64)
  keywordCount                         Int               @map("keyword_count")
  providerTaskCount                    Int               @map("provider_task_count")
  minimumSubmitRequestCount            Int               @map("minimum_submit_request_count")
  minimumCheckRequestCount             Int               @map("minimum_check_request_count")
  minimumGetRequestCount               Int               @map("minimum_get_request_count")
  blockers                             Json
  responseSnapshot                     Json              @map("response_snapshot")
  executionSnapshot                    Json?             @map("execution_snapshot")
  executionSnapshotHash                Bytes?            @map("execution_snapshot_hash")
  calculatedAt                         DateTime          @map("calculated_at") @db.Timestamptz(6)
  expiresAt                            DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt                            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  rankRun        RankJobRun?
  automationRuns AutomationRun[]

  @@unique([workspaceId, idempotencyScope, idempotencyKey], map: "rank_estimates_workspace_scope_idempotency_key")
  @@unique([workspaceId, projectId, id], map: "rank_estimates_tenant_project_id_key")
  @@index([workspaceId, projectId, trackingContextId, createdAt], map: "rank_estimates_tenant_context_created_idx")
  @@index([expiresAt, id], map: "rank_estimates_expiry_idx")
  @@map("rank_estimates")
}

model RankJobRun {
  jobId                     String                @id @map("job_id") @db.Uuid
  workspaceId               String                @map("workspace_id") @db.Uuid
