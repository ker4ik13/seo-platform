  run KeywordResearchRun @relation(fields: [workspaceId, projectId, runId], references: [workspaceId, projectId, id], onDelete: Cascade, onUpdate: Restrict, map: "keyword_research_pages_run_tenant_fkey")

  @@unique([runId, page], map: "keyword_research_pages_run_page_key")
  @@index([workspaceId, projectId, runId, page], map: "keyword_research_pages_tenant_run_page_idx")
  @@map("keyword_research_pages")
}

model KeywordResearchRow {
