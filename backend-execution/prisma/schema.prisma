  domain            String?               @db.VarChar(253)
  database          String?               @db.VarChar(16)
  inputSnapshot     Json                  @map("input_snapshot")
  providerTaskId    String?               @map("provider_task_id") @db.VarChar(255)
  overview          Json?
  competitors       Json?
  maxKeywords       Int                   @map("max_keywords")
  status            KeywordResearchStatus @default(QUEUED)
  nextPage          Int                   @default(1) @map("next_page")
  totalAvailable    Int?                  @map("total_available")
  collectedKeywords Int                   @default(0) @map("collected_keywords")
  selectedKeywords  Int                   @default(0) @map("selected_keywords")
  importedKeywords  Int                   @default(0) @map("imported_keywords")
  duplicatePolicy   String?               @map("duplicate_policy") @db.VarChar(16)
  targetGroupPath   String?               @map("target_group_path") @db.VarChar(2048)
  distributionMode  String                @default("SINGLE_GROUP") @map("distribution_mode") @db.VarChar(32)
  entitlement       Json?
  retryAt           DateTime?             @map("retry_at") @db.Timestamptz(6)
  failureCode       String?               @map("failure_code") @db.VarChar(64)
  leaseToken        String?               @map("lease_token") @db.Uuid
  version           Int                   @default(1)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt        DateTime?             @map("finished_at") @db.Timestamptz(6)

  job        Job                     @relation(fields: [workspaceId, projectId, jobId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "keyword_research_runs_job_tenant_fkey")
  binding    ProjectConnectorBinding @relation(fields: [workspaceId, projectId, bindingId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "keyword_research_runs_binding_tenant_fkey")
  route      ProjectConnectorRoute   @relation(fields: [workspaceId, projectId, bindingId, routeId], references: [workspaceId, projectId, bindingId, id], onDelete: Restrict, onUpdate: Restrict, map: "keyword_research_runs_route_tenant_fkey")
  credential IntegrationCredential   @relation(fields: [workspaceId, credentialId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "keyword_research_runs_credential_tenant_fkey")
  pages      KeywordResearchPage[]
  rows       KeywordResearchRow[]

  @@unique([workspaceId, projectId, id], map: "keyword_research_runs_tenant_project_id_key")
  @@unique([workspaceId, projectId, jobId], map: "keyword_research_runs_tenant_project_job_key")
  @@index([workspaceId, projectId, createdAt(sort: Desc)], map: "keyword_research_runs_tenant_created_idx")
  @@index([status, retryAt, createdAt], map: "keyword_research_runs_dispatch_idx")
  @@map("keyword_research_runs")
}

model KeywordResearchPage {
