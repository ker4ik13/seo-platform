generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum WorkspaceStatus {
  ACTIVE
  READ_ONLY
  SUSPENDED
  DELETING
  DELETED
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETING
  DELETED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum OneTimeTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
}

enum WorkspaceInviteStatus {
  SENT
  DELIVERED
  ACCEPTED
  EXPIRED
  REVOKED
  BOUNCED
}

enum ProjectAccessLevel {
  NONE
  VIEWER
  MEMBER
  MANAGER
}

enum RankExecutionGrantDecision {
  GRANTED
  DENIED
}

enum RankExecutionGrantDenialReason {
  WORKSPACE_NOT_ACTIVE
  PROJECT_NOT_ACTIVE
  PROJECT_VERSION_CHANGED
  MEMBERSHIP_NOT_ACTIVE
  MEMBERSHIP_VERSION_CHANGED
  RUN_PERMISSION_DENIED
  ENTITLEMENT_NOT_AVAILABLE
  ENTITLEMENT_DENIED
  QUOTA_NOT_AVAILABLE
  QUOTA_EXHAUSTED
}

enum MfaMethodType {
  TOTP
}

enum MfaMethodStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  emailNormalized String     @unique(map: "users_email_normalized_key") @map("email_normalized") @db.VarChar(320)
  emailDisplay    String     @map("email_display") @db.VarChar(320)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String?    @map("password_hash") @db.Text
  displayName     String     @map("display_name") @db.VarChar(160)
  locale          String     @default("en") @db.VarChar(16)
  timezone        String     @default("UTC") @db.VarChar(64)
  country         String?    @db.Char(2)
  status          UserStatus @default(PENDING_VERIFICATION)
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  identities  UserIdentity[]
  sessions    Session[]
  memberships WorkspaceMember[]
  oneTimeTokens OneTimeToken[]
  consents      UserConsent[]
  mfaMethods    MfaMethod[]
  recoveryCodes RecoveryCode[]
  mfaChallenges MfaChallenge[]

  @@index([status, createdAt])
  @@map("users")
}

model MfaMethod {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  type             MfaMethodType
  status           MfaMethodStatus @default(PENDING)
  secretEncrypted  String          @map("secret_encrypted") @db.Text
  lastUsedCounter  BigInt?         @map("last_used_counter")
  confirmedAt      DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  lastUsedAt       DateTime?       @map("last_used_at") @db.Timestamptz(6)
  disabledAt       DateTime?       @map("disabled_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@map("mfa_methods")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("recovery_codes")
}

model MfaChallenge {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique(map: "mfa_challenges_token_hash_key") @map("token_hash") @db.Char(64)
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model UserIdentity {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  providerEmail   String?  @map("provider_email") @db.VarChar(320)
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

model Session {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accessTokenHash  String    @unique(map: "sessions_access_token_hash_key") @map("access_token_hash") @db.Text
  refreshTokenHash String    @unique(map: "sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Text
  csrfTokenHash    String    @map("csrf_token_hash") @db.Text
  familyId         String    @map("family_id") @db.Uuid
  replacedBySessionId String? @map("replaced_by_session_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.Inet
  authenticatedAt  DateTime  @default(now()) @map("authenticated_at") @db.Timestamptz(6)
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model OneTimeToken {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   OneTimeTokenPurpose
  tokenHash String              @unique(map: "one_time_tokens_token_hash_key") @map("token_hash") @db.Text
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?          @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("one_time_tokens")
}

model UserConsent {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  type            ConsentType
  documentVersion String      @map("document_version") @db.VarChar(64)
  accepted        Boolean
  source          String      @db.VarChar(32)
  ipAddress       String?     @map("ip_address") @db.Inet
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("user_consents")
}

model AuthRateLimitBucket {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  action          String    @db.VarChar(32)
  subjectHash     String    @map("subject_hash") @db.Char(64)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(6)
  counter         Int       @default(1)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([action, subjectHash])
  @@index([blockedUntil])
  @@map("auth_rate_limit_buckets")
}

model Workspace {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String          @db.VarChar(160)
  slug            String          @unique @db.VarChar(100)
  country         String?         @db.Char(2)
  locale          String          @default("en") @db.VarChar(16)
  timezone        String          @default("UTC") @db.VarChar(64)
  billingCurrency String          @default("RUB") @map("billing_currency") @db.Char(3)
  status          WorkspaceStatus @default(ACTIVE)
  ownerUserId     String          @map("owner_user_id") @db.Uuid
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)

  members  WorkspaceMember[]
  projects Project[]
  invites  WorkspaceInvite[]

  @@index([ownerUserId])
  @@index([status, createdAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  roleCode    String       @map("role_code") @db.VarChar(64)
  allProjects Boolean      @default(true) @map("all_projects")
  status      MemberStatus @default(INVITED)
  invitedBy   String?      @map("invited_by") @db.Uuid
  version     Int          @default(1)
  joinedAt    DateTime?    @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectAccesses ProjectMemberAccess[]

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id              String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String                @map("workspace_id") @db.Uuid
  emailNormalized String                @map("email_normalized") @db.VarChar(320)
  emailDisplay    String                @map("email_display") @db.VarChar(320)
  roleCode        String                @map("role_code") @db.VarChar(64)
  allProjects     Boolean               @default(true) @map("all_projects")
  projectAccesses Json                  @map("project_accesses")
  message         String?               @db.Text
  tokenHash       String                @unique(map: "workspace_invites_token_hash_key") @map("token_hash") @db.Text
  status          WorkspaceInviteStatus @default(SENT)
  invitedBy       String                @map("invited_by") @db.Uuid
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?             @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?             @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([emailNormalized, status])
  @@map("workspace_invites")
}

model Project {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  name           String        @db.VarChar(160)
  slug           String        @db.VarChar(100)
  domain         String        @db.VarChar(255)
  locale         String        @default("en") @db.VarChar(16)
  timezone       String        @default("UTC") @db.VarChar(64)
  status         ProjectStatus @default(DRAFT)
  createdBy      String        @map("created_by") @db.Uuid
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  memberAccesses ProjectMemberAccess[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, createdAt])
  @@map("projects")
}

model ProjectMemberAccess {
  id        String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String             @map("project_id") @db.Uuid
  memberId  String             @map("member_id") @db.Uuid
  level     ProjectAccessLevel
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId, level])
  @@map("project_member_access")
}

model RankExecutionGrantReceipt {
  id                 String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId        String                          @map("workspace_id") @db.Uuid
  projectId          String                          @map("project_id") @db.Uuid
  actorId            String                          @map("actor_id") @db.Uuid
  membershipId       String                          @map("membership_id") @db.Uuid
  jobId              String                          @map("job_id") @db.Uuid
  jobItemId          String                          @map("job_item_id") @db.Uuid
  executionAttempt   Int                             @map("execution_attempt")
  projectVersion     Int                             @map("project_version")
  membershipVersion  Int                             @map("membership_version")
  policyVersion      String                          @map("policy_version") @db.VarChar(64)
  idempotencyScope   String                          @map("idempotency_scope") @db.VarChar(180)
  idempotencyKey     String                          @map("idempotency_key") @db.VarChar(180)
  requestHash        Bytes                           @map("request_hash")
  scopeHash          Bytes                           @map("scope_hash")
  requestSnapshot    Json                            @map("request_snapshot")
  responseSnapshot   Json                            @map("response_snapshot")
  decision           RankExecutionGrantDecision
  denialReason       RankExecutionGrantDenialReason? @map("denial_reason")
  decidedAt          DateTime                        @map("decided_at") @db.Timestamptz(6)
  expiresAt          DateTime?                       @map("expires_at") @db.Timestamptz(6)
  quotaReservationId String?                         @map("quota_reservation_id") @db.Uuid
  correlationId      String                          @map("correlation_id") @db.VarChar(100)
  createdAt          DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  quotaReservation RankExecutionQuotaReservation? @relation(fields: [quotaReservationId, workspaceId, projectId, actorId, jobId, jobItemId, executionAttempt, policyVersion], references: [id, workspaceId, projectId, actorId, jobId, jobItemId, executionAttempt, policyVersion], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, idempotencyScope, idempotencyKey], map: "rank_execution_grants_workspace_idempotency_key")
  @@unique([workspaceId, jobItemId, executionAttempt], map: "rank_execution_grants_item_attempt_key")
  @@index([workspaceId, projectId, decidedAt], map: "rank_execution_grants_tenant_decided_idx")
  @@index([expiresAt, id], map: "rank_execution_grants_expiry_idx")
  @@map("rank_execution_grant_receipts")
}

model RankExecutionQuotaReservation {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  actorId          String   @map("actor_id") @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  jobItemId        String   @map("job_item_id") @db.Uuid
  executionAttempt Int      @map("execution_attempt")
  meter            String   @db.VarChar(64)
  quantity         Int
  policyVersion    String   @map("policy_version") @db.VarChar(64)
  windowStartedAt  DateTime @map("window_started_at") @db.Timestamptz(6)
  windowEndsAt     DateTime @map("window_ends_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  grantReceipts RankExecutionGrantReceipt[]

  @@unique([workspaceId, jobItemId, executionAttempt], map: "rank_quota_reservations_item_attempt_key")
  @@unique([id, workspaceId, projectId, actorId, jobId, jobItemId, executionAttempt, policyVersion], map: "rank_quota_reservations_receipt_binding_key")
  @@index([workspaceId, meter, windowStartedAt, createdAt], map: "rank_quota_reservations_window_idx")
  @@index([workspaceId, projectId, createdAt], map: "rank_quota_reservations_project_idx")
  @@map("rank_execution_quota_reservations")
}

model AuditEvent {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String?  @map("workspace_id") @db.Uuid
  projectId       String?  @map("project_id") @db.Uuid
  actorType       String   @map("actor_type") @db.VarChar(32)
  actorId         String?  @map("actor_id") @db.Uuid
  action          String   @db.VarChar(160)
  resourceType    String   @map("resource_type") @db.VarChar(100)
  resourceId      String?  @map("resource_id") @db.Uuid
  outcome         String   @db.VarChar(32)
  reason          String?  @db.Text
  redactedChanges Json?    @map("redacted_changes")
  requestId       String?  @map("request_id") @db.VarChar(100)
  traceId         String?  @map("trace_id") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(160)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  aggregateVer  Int          @map("aggregate_version")
  workspaceId   String?      @map("workspace_id") @db.Uuid
  projectId     String?      @map("project_id") @db.Uuid
  payload       Json
  metadata      Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, aggregateVer])
  @@map("outbox_events")
}
