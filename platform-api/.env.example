NODE_ENV=development
BIND_ADDRESS=127.0.0.1
PORT=4000
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql://platform:replace-me@postgres:5432/platform_db
DATABASE_POOL_MAX=10
NATS_URL=nats://nats:4222
NATS_USER=platform
NATS_PASSWORD=replace-me
OUTBOX_PUBLISHER_ENABLED=false
NATS_EVENT_ENVIRONMENT=development
NATS_EVENT_STREAM=IDENTITY_EVENTS
NATS_AUTH_EMAIL_STREAM=AUTH_EMAIL_EVENTS
OUTBOX_PUBLISH_INTERVAL_MS=1000
OUTBOX_PUBLISH_BATCH_SIZE=20
OUTBOX_PUBLISH_MAX_ATTEMPTS=10
OUTBOX_PUBLISH_RETRY_BASE_MS=1000
OUTBOX_PUBLISH_RETRY_MAX_MS=300000
OUTBOX_PUBLISH_ACK_TIMEOUT_MS=5000
SESSION_EXPIRY_SWEEPER_ENABLED=false
SESSION_EXPIRY_SWEEPER_INTERVAL_MS=60000
SESSION_EXPIRY_SWEEPER_BATCH_SIZE=50
SESSION_EXPIRY_SWEEPER_TRANSACTION_TIMEOUT_MS=10000
SESSION_EXPIRY_SWEEPER_LOCK_TIMEOUT_MS=500
SEO_DATA_INTERNAL_URL=http://seo-data:4001
JOBS_INTERNAL_URL=http://jobs-integrations:4002
REALTIME_INTERNAL_URL=http://realtime:4003
INTERNAL_REQUEST_TIMEOUT_MS=1500
INTERNAL_COMMAND_TIMEOUT_MS=15000
PLATFORM_API_TO_SEO_DATA_TOKEN=replace-with-a-distinct-random-seo-data-token
PLATFORM_API_TO_JOBS_TOKEN=replace-with-a-distinct-random-jobs-token
PLATFORM_API_TO_REALTIME_TOKEN=replace-with-a-distinct-random-realtime-token
JOBS_TO_PLATFORM_RANK_GRANT_TOKEN=replace-with-a-distinct-random-rank-grant-token
JOBS_TO_PLATFORM_AUTH_EMAIL_TOKEN=replace-with-a-distinct-random-auth-email-token
PLATFORM_API_TO_JOBS_CREDENTIAL_TOKEN=replace-with-a-distinct-random-credential-token
PLATFORM_API_TO_REALTIME_NOTIFICATION_TOKEN=replace-with-a-distinct-random-notification-token
CORS_ORIGINS=https://example.com
WEB_PUBLIC_URL=https://example.com
AUTH_ACCESS_COOKIE_NAME=seo_access
AUTH_SESSION_COOKIE_NAME=seo_session
AUTH_CSRF_COOKIE_NAME=seo_csrf
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=30
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
AUTH_RECENT_AUTHENTICATION_MINUTES=10
AUTH_TOTP_ISSUER=SEO Workspace
AUTH_COOKIE_SECURE=true
AUTH_PASSWORD_PEPPER=replace-with-a-long-random-secret
AUTH_DATA_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
AUTH_EXPOSE_DEVELOPMENT_TOKENS=false
