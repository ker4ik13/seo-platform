{
  "name": "seo-platform-development-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @seo-platform/contracts build && pnpm --filter '!@seo-platform/contracts' --recursive --if-present run build",
    "typecheck": "pnpm --filter @seo-platform/contracts build && pnpm --recursive --if-present run typecheck",
    "lint": "oxlint platform-contracts/src platform-api/src platform-seo-data/src platform-jobs-integrations/src platform-realtime/src platform-web/app platform-web/components platform-web/lib platform-web/next.config.ts platform-admin/app platform-admin/lib platform-admin/next.config.ts platform-infrastructure/tests --import-plugin --react-plugin --promise-plugin --node-plugin --deny-warnings",
    "test": "pnpm --recursive --if-present run test && pnpm infra:test",
    "infra:test": "node --test 'platform-infrastructure/tests/*.test.mjs'",
    "infra:validate": "docker compose -f platform-infrastructure/compose.dokploy.yml config --quiet",
    "infra:validate:example": "JOBS_TO_PLATFORM_RANK_GRANT_TOKEN=ci-only-distinct-platform-rank-grant-token PLATFORM_API_TO_REALTIME_NOTIFICATION_TOKEN=ci-only-distinct-notification-token JOBS_TO_SEO_RANK_RESULT_TOKEN=ci-only-distinct-seo-rank-result-token RANK_HISTORY_CURSOR_KEY=ci-only-distinct-rank-history-cursor-key docker compose --env-file .env.example -f platform-infrastructure/compose.dokploy.yml config --quiet",
    "prisma:generate": "pnpm --filter './platform-api' --filter './platform-seo-data' --filter './platform-jobs-integrations' --filter './platform-realtime' run prisma:generate",
    "prisma:validate": "pnpm --filter './platform-api' --filter './platform-seo-data' --filter './platform-jobs-integrations' --filter './platform-realtime' run prisma:validate"
  },
  "devDependencies": {
    "oxlint": "1.76.0"
  }
}
